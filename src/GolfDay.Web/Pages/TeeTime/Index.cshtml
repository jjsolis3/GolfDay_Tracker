@page
@model GolfDay.Web.Pages.TeeTime.IndexModel
@using GolfDay.Domain.Enums
@{
    ViewData["Title"] = "Book a Tee Time";
    var prevDate = Model.SelectedDate.AddDays(-1);
    var nextDate = Model.SelectedDate.AddDays(1);
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var isToday = Model.SelectedDate == today;
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex align-items-center mb-4">
        <h1 class="fw-bold mb-0">
            <i class="bi bi-flag-fill me-2 text-success"></i>Book a Tee Time
        </h1>
    </div>

    <div class="row g-4">
        <!-- LEFT SIDEBAR -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-semibold mb-2"><i class="bi bi-buildings me-2 text-success"></i>Select Club</h6>
                    @if (!Model.MyClubs.Any())
                    {
                        <p class="text-muted small mb-0">
                            You are not a member of any club.
                            <a asp-page="/Club/Join">Join a club</a> to book tee times.
                        </p>
                    }
                    else
                    {
                        <form method="get">
                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                            <select name="clubId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="0">-- Choose a club --</option>
                                @foreach (var club in Model.MyClubs)
                                {
                                    <option value="@club.Id" @(Model.ClubId == club.Id ? "selected" : "")>@club.Name</option>
                                }
                            </select>
                        </form>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-semibold mb-2"><i class="bi bi-calendar3 me-2 text-success"></i>Date</h6>
                    <div class="d-flex align-items-center gap-1 mb-2">
                        <a asp-page asp-route-clubId="@Model.ClubId"
                           asp-route-date="@prevDate.ToString("yyyy-MM-dd")"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        <span class="flex-grow-1 text-center small fw-semibold">
                            @(isToday ? "Today" : Model.SelectedDate.ToString("ddd, MMM d"))
                        </span>
                        <a asp-page asp-route-clubId="@Model.ClubId"
                           asp-route-date="@nextDate.ToString("yyyy-MM-dd")"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                    <form method="get">
                        <input type="hidden" name="clubId" value="@Model.ClubId" />
                        <input type="date" name="date" class="form-control form-control-sm"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()" />
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-semibold mb-2"><i class="bi bi-bookmark-check me-2 text-success"></i>My Bookings</h6>
                    @if (!Model.MyBookings.Any())
                    {
                        <p class="text-muted small mb-0">No upcoming bookings.</p>
                    }
                    else
                    {
                        @foreach (var bk in Model.MyBookings)
                        {
                            <div class="bg-light rounded p-2 mb-2">
                                <div class="fw-semibold small text-success">
                                    @bk.TeeTimeSlot.StartTime.ToString("h\\:mm tt")
                                    — @bk.TeeTimeSlot.SlotDate.ToString("MMM d")
                                </div>
                                <div class="small text-muted">@bk.TeeTimeSlot.Course?.Name</div>
                                <div class="d-flex align-items-center justify-content-between mt-1">
                                    <span class="badge bg-success">@bk.NumberOfPlayers player(s)</span>
                                    <form method="post" asp-page-handler="Cancel" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@bk.Id" />
                                        <input type="hidden" name="clubId" value="@Model.ClubId" />
                                        <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0"
                                                onclick="return confirm('Cancel this booking?')">Cancel</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9">
            @if (Model.ClubId == 0 || Model.SelectedClub == null)
            {
                <div class="text-center py-5">
                    <i class="bi bi-buildings display-1 text-muted opacity-50"></i>
                    <h4 class="mt-4 text-muted">Select a club to view tee times</h4>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h2 class="h4 fw-bold mb-0">@Model.SelectedClub.Name</h2>
                        <p class="text-muted mb-0 small">
                            <i class="bi bi-calendar3 me-1"></i>
                            @(isToday ? "Today, " : "")@Model.SelectedDate.ToString("dddd, MMMM d, yyyy")
                        </p>
                    </div>
                    <span class="badge bg-success fs-6">@Model.AvailableSlots.Count slot(s)</span>
                </div>

                @if (!Model.AvailableSlots.Any())
                {
                    <div class="text-center py-5 bg-white rounded-3 shadow-sm">
                        <i class="bi bi-calendar-x display-1 text-muted opacity-50"></i>
                        <h5 class="mt-4 text-muted">No tee times available</h5>
                        <p class="text-muted">Try a different date or contact the club manager.</p>
                        <a asp-page asp-route-clubId="@Model.ClubId"
                           asp-route-date="@nextDate.ToString("yyyy-MM-dd")"
                           class="btn btn-success">
                            <i class="bi bi-chevron-right me-1"></i>Check Tomorrow
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var slot in Model.AvailableSlots)
                        {
                            var bookedCount = slot.Bookings.Where(b => b.Status == TeeTimeBookingStatus.Confirmed).Sum(b => b.NumberOfPlayers);
                            var spotsLeft = slot.MaxPlayers - bookedCount;
                            var isFull = spotsLeft <= 0;

                            <div class="col-md-6 col-xl-4">
                                <div class="card border-0 shadow-sm h-100 @(isFull ? "opacity-50" : "")">
                                    <div class="card-body d-flex flex-column p-3">
                                        <div class="d-flex align-items-start justify-content-between mb-2">
                                            <div style="font-size:1.8rem;font-weight:800;line-height:1;color:#0d6832;">
                                                @slot.StartTime.ToString("h\\:mm")
                                                <span class="fs-6 fw-normal text-muted">@slot.StartTime.ToString("tt")</span>
                                            </div>
                                            @if (isFull)
                                            {
                                                <span class="badge bg-danger">Full</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@spotsLeft open</span>
                                            }
                                        </div>

                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-flag me-1"></i>@(slot.Course?.Name ?? "Course TBD")
                                        </p>

                                        <div class="mb-2">
                                            <div class="progress" style="height:5px;">
                                                <div class="progress-bar @(isFull ? "bg-danger" : spotsLeft <= 1 ? "bg-warning" : "bg-success")"
                                                     style="width:@(slot.MaxPlayers > 0 ? bookedCount * 100 / slot.MaxPlayers : 0)%"></div>
                                            </div>
                                            <div class="small text-muted mt-1">@bookedCount / @slot.MaxPlayers players booked</div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(slot.Notes))
                                        {
                                            <p class="text-muted small mb-2 fst-italic">
                                                <i class="bi bi-info-circle me-1"></i>@slot.Notes
                                            </p>
                                        }

                                        <div class="mt-auto pt-2">
                                            @if (isFull)
                                            {
                                                <button class="btn btn-secondary w-100" disabled>Fully Booked</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-success w-100"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#bookModal"
                                                        data-slot-id="@slot.Id"
                                                        data-slot-time="@slot.StartTime.ToString("h\\:mm tt")"
                                                        data-slot-course="@(slot.Course?.Name ?? "TBD")"
                                                        data-spots-left="@spotsLeft">
                                                    <i class="bi bi-calendar-check me-1"></i>Book Now
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- BOOKING MODAL -->
<div class="modal fade" id="bookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Book">
                @Html.AntiForgeryToken()
                <input type="hidden" name="slotId" id="modalSlotId" />
                <input type="hidden" name="clubId" value="@Model.ClubId" />
                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-calendar-check me-2"></i>Book Tee Time
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="modalSlotInfo" class="alert alert-success mb-3 py-2 small"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Number of Players</label>
                        <div class="d-flex gap-2">
                            @for (int i = 1; i <= 4; i++)
                            {
                                <div class="flex-fill">
                                    <input type="radio" class="btn-check" name="numberOfPlayers"
                                           id="np@(i)" value="@i" @(i == 1 ? "checked" : "") />
                                    <label class="btn btn-outline-success w-100" for="np@(i)">@i</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold" for="bookingNotes">Notes (optional)</label>
                        <textarea name="notes" id="bookingNotes" class="form-control" rows="2"
                                  placeholder="Any special requests…" maxlength="200"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-lg me-1"></i>Confirm Booking
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('bookModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('modalSlotId').value = btn.dataset.slotId;
            document.getElementById('modalSlotInfo').innerHTML =
                `<i class="bi bi-clock me-1"></i><strong>${btn.dataset.slotTime}</strong> &nbsp;|&nbsp; ` +
                `<i class="bi bi-flag me-1"></i>${btn.dataset.slotCourse} &nbsp;|&nbsp; ` +
                `<span class="fw-semibold">${btn.dataset.spotsLeft} spot(s) remaining</span>`;
            const spots = parseInt(btn.dataset.spotsLeft, 10);
            document.querySelectorAll('input[name="numberOfPlayers"]').forEach(r => {
                r.disabled = parseInt(r.value, 10) > spots;
                if (r.disabled && r.checked) {
                    const first = document.querySelector('input[name="numberOfPlayers"]:not([disabled])');
                    if (first) first.checked = true;
                }
            });
        });
    </script>
}
