@page "{slug}"
@model GolfDay.Web.Pages.Club.DashboardModel
@{
    ViewData["Title"] = Model.Club?.Name ?? "Club Dashboard";
}

@if (Model.Club == null)
{
    <div class="container py-5 text-center">
        <h2>Club not found</h2>
        <a asp-page="/Index" class="btn btn-success mt-3">Return Home</a>
    </div>
    return;
}

<!-- Club Header -->
<div class="bg-success text-white py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1 fw-bold">@Model.Club.Name</h1>
                <p class="mb-0 opacity-75">
                    @if (!string.IsNullOrEmpty(Model.Club.City))
                    {
                        <i class="bi bi-geo-alt me-1"></i>@Model.Club.City@(!string.IsNullOrEmpty(Model.Club.State) ? $", {Model.Club.State}" : "")
                        <span class="mx-2">|</span>
                    }
                    <i class="bi bi-people me-1"></i>@Model.MemberCount Members
                </p>
            </div>
            <div class="col-auto">
                @if (Model.UserRole >= GolfDay.Domain.Enums.ClubRole.Manager)
                {
                    <a asp-area="Admin" asp-page="/Clubs/Manage" asp-route-id="@Model.Club.Id" class="btn btn-warning">
                        <i class="bi bi-gear me-2"></i>Manage Club
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Active Events -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-calendar-event me-2 text-success"></i>Events</span>
                    <a asp-page="/Events/Index" class="btn btn-sm btn-outline-success">View All</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (!Model.UpcomingEvents.Any())
                    {
                        <div class="list-group-item text-center text-muted py-4">
                            <i class="bi bi-calendar-x fs-3 mb-2 d-block"></i>No upcoming events scheduled
                        </div>
                    }
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <a asp-page="/Events/Details" asp-route-id="@ev.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                @if (ev.Status == GolfDay.Domain.Enums.EventStatus.InProgress)
                                {
                                    <span class="badge bg-danger me-2 badge-live">LIVE</span>
                                }
                                <span class="fw-semibold">@ev.Name</span>
                                <br>
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>@ev.EventDate.ToString("MMM d, yyyy")
                                    @if (ev.Course != null)
                                    {
                                        <span class="ms-2"><i class="bi bi-geo-alt me-1"></i>@ev.Course.Name</span>
                                    }
                                </small>
                            </div>
                            <span class="badge bg-secondary">@ev.EventType</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Active Leagues -->
            @if (Model.ActiveLeagues.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent fw-bold">
                        <i class="bi bi-people me-2 text-success"></i>Active Leagues
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var league in Model.ActiveLeagues)
                        {
                            <a asp-page="/League/Details" asp-route-id="@league.Id" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <span class="fw-semibold">@league.Name</span>
                                        <br>
                                        <small class="text-muted">@league.Entries.Count players • Ends @league.EndDate.ToString("MMM d, yyyy")</small>
                                    </div>
                                    <span class="badge bg-success align-self-center">@league.Format</span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Club Stats -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent fw-bold">
                    <i class="bi bi-graph-up me-2 text-success"></i>Season Highlights
                </div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-6">
                            <div class="stat-card card bg-light p-3">
                                <div class="fw-bold fs-3 text-success">@Model.EventsThisYear</div>
                                <small class="text-muted">Events This Year</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card card bg-light p-3">
                                <div class="fw-bold fs-3 text-warning">@Model.TournamentsThisYear</div>
                                <small class="text-muted">Tournaments</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card card bg-light p-3">
                                <div class="fw-bold fs-3 text-info">@Model.MemberCount</div>
                                <small class="text-muted">Members</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card card bg-light p-3">
                                <div class="fw-bold fs-3 text-danger">@Model.HoleInOnesThisYear</div>
                                <small class="text-muted">Hole-in-Ones</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Courses -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-bold">
                    <i class="bi bi-map me-2 text-success"></i>Courses
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var course in Model.Club.Courses.Where(c => c.IsActive))
                    {
                        <div class="list-group-item">
                            <div class="fw-semibold">@course.Name</div>
                            <small class="text-muted">@course.NumberOfHoles holes • Par @course.ParTotal
                                @if (course.CourseRating.HasValue)
                                {
                                    <span>• Rating @course.CourseRating.Value.ToString("F1")</span>
                                }
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
