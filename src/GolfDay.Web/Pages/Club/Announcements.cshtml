@page
@model GolfDay.Web.Pages.Club.AnnouncementsModel
@using GolfDay.Domain.Enums
@{
    ViewData["Title"] = $"Announcements – {Model.Club?.Name}";
}

@if (Model.Club == null)
{
    <div class="container py-5 text-center">
        <i class="bi bi-buildings display-1 text-muted"></i>
        <h3 class="mt-3">Club Not Found</h3>
        <a asp-page="/Index" class="btn btn-outline-success mt-3">Return Home</a>
    </div>
    return;
}

@section Styles {
    <style>
        .announcement-card { transition: box-shadow .15s; }
        .announcement-card:hover { box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.1) !important; }
        .pin-stripe { border-left: 4px solid #ffc107; }
    </style>
}

<!-- Club header bar -->
<div class="bg-success text-white py-4 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb mb-0" style="--bs-breadcrumb-divider-color:rgba(255,255,255,.5);">
                <li class="breadcrumb-item">
                    <a asp-page="/Club/Dashboard" asp-route-slug="@Model.Club.Slug"
                       class="text-white-50 text-decoration-none">@Model.Club.Name</a>
                </li>
                <li class="breadcrumb-item active text-white">Announcements</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="fw-bold mb-0 h2">
                    <i class="bi bi-megaphone me-2"></i>Club Announcements
                </h1>
                <p class="mb-0 opacity-75 mt-1 small">
                    @Model.Club.Name
                    @if (!string.IsNullOrEmpty(Model.Club.City))
                    {
                        <span class="mx-2">·</span>
                        <i class="bi bi-geo-alt me-1"></i>@Model.Club.City@(!string.IsNullOrEmpty(Model.Club.State) ? $", {Model.Club.State}" : "")
                    }
                </p>
            </div>
            <a asp-page="/Club/Dashboard" asp-route-slug="@Model.Club.Slug"
               class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Club Dashboard
            </a>
        </div>
    </div>
</div>

@{
    var pinned = Model.Announcements.Where(a => a.IsPinned).ToList();
    var regular = Model.Announcements.Where(a => !a.IsPinned).ToList();
}

<div class="container pb-5">

    @if (!Model.Announcements.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-megaphone fs-1 text-muted opacity-25 d-block mb-3"></i>
                <h5 class="text-muted">No announcements</h5>
                <p class="text-muted mb-0">Check back later for updates from your club.</p>
            </div>
        </div>
    }
    else
    {
        @if (pinned.Any())
        {
            <div class="mb-4">
                <h6 class="text-uppercase text-muted fw-semibold letter-spacing-1 mb-3">
                    <i class="bi bi-pin-angle-fill me-1 text-warning"></i>Pinned
                </h6>
                <div class="d-flex flex-column gap-3">
                    @foreach (var ann in pinned)
                    {
                        <div class="card border-0 shadow-sm announcement-card pin-stripe">
                            <div class="card-body py-3 px-4">
                                <div class="d-flex align-items-start gap-2 mb-2 flex-wrap">
                                    <i class="bi bi-pin-angle-fill text-warning mt-1" title="Pinned"></i>
                                    <h5 class="mb-0 fw-bold flex-grow-1">@ann.Title</h5>
                                    @{
                                        var targetLabel = ann.Target switch
                                        {
                                            AnnouncementTarget.ManagersOnly  => "Managers",
                                            AnnouncementTarget.ActiveMembers => "Active Members",
                                            _                                => null
                                        };
                                    }
                                    @if (targetLabel != null)
                                    {
                                        <span class="badge bg-secondary rounded-pill small">@targetLabel</span>
                                    }
                                </div>
                                <p class="text-body mb-3" style="white-space:pre-line;">@ann.Body</p>
                                <div class="d-flex gap-3 flex-wrap">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar me-1"></i>
                                        @((ann.PublishedAt ?? ann.CreatedAt).ToString("MMMM d, yyyy"))
                                    </small>
                                    @if (ann.CreatedBy != null)
                                    {
                                        <small class="text-muted">
                                            <i class="bi bi-person me-1"></i>@ann.CreatedBy.FullName
                                        </small>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (regular.Any())
        {
            @if (pinned.Any())
            {
                <h6 class="text-uppercase text-muted fw-semibold mb-3">
                    <i class="bi bi-megaphone me-1"></i>Recent
                </h6>
            }
            <div class="d-flex flex-column gap-3">
                @foreach (var ann in regular)
                {
                    <div class="card border-0 shadow-sm announcement-card">
                        <div class="card-body py-3 px-4">
                            <div class="d-flex align-items-start gap-2 mb-2 flex-wrap">
                                <h5 class="mb-0 fw-semibold flex-grow-1">@ann.Title</h5>
                                @{
                                    var targetLabelR = ann.Target switch
                                    {
                                        AnnouncementTarget.ManagersOnly  => "Managers",
                                        AnnouncementTarget.ActiveMembers => "Active Members",
                                        _                                => null
                                    };
                                }
                                @if (targetLabelR != null)
                                {
                                    <span class="badge bg-secondary rounded-pill small">@targetLabelR</span>
                                }
                            </div>
                            <p class="text-body mb-3" style="white-space:pre-line;">@ann.Body</p>
                            <div class="d-flex gap-3 flex-wrap">
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>
                                    @((ann.PublishedAt ?? ann.CreatedAt).ToString("MMMM d, yyyy"))
                                </small>
                                @if (ann.CreatedBy != null)
                                {
                                    <small class="text-muted">
                                        <i class="bi bi-person me-1"></i>@ann.CreatedBy.FullName
                                    </small>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
