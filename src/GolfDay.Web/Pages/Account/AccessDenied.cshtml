@page
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
        <h1 class="display-4 fw-bold mt-3">Access Denied</h1>
        <p class="lead text-muted">You don't have permission to view this page.</p>
        <div class="mt-4">
            <a asp-page="/Index" class="btn btn-success btn-lg me-3">
                <i class="bi bi-house me-2"></i>Return Home
            </a>
            <a asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </a>
        </div>
    </div>
</div>
