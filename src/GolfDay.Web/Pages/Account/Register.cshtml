@page
@model GolfDay.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <h2 class="mb-0"><i class="bi bi-person-plus me-2"></i>Create Your Account</h2>
                    <small>Join GolfDay Tracker</small>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FirstName" class="form-label">First Name</label>
                                <input asp-for="Input.FirstName" class="form-control" placeholder="John" />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.LastName" class="form-label">Last Name</label>
                                <input asp-for="Input.LastName" class="form-control" placeholder="Smith" />
                                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Email" class="form-label">Email Address</label>
                                <input asp-for="Input.Email" class="form-control" placeholder="you@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Password" class="form-label">Password</label>
                                <input asp-for="Input.Password" class="form-control" placeholder="Min 8 characters" />
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.HandicapIndex" class="form-label">Handicap Index <span class="text-muted">(optional)</span></label>
                                <input asp-for="Input.HandicapIndex" class="form-control" placeholder="e.g. 12.4" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.GhinNumber" class="form-label">GHIN # <span class="text-muted">(optional)</span></label>
                                <input asp-for="Input.GhinNumber" class="form-control" placeholder="GHIN number" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2 mt-4">
                            <i class="bi bi-person-check me-2"></i>Create Account
                        </button>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    Already have an account? <a asp-page="/Account/Login" class="text-success fw-bold">Sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
