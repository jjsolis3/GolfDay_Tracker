@page
@model GolfDay.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    <div class="profile-avatar bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:80px;height:80px;font-size:2rem;">
                        @Model.User.FirstName[0]@Model.User.LastName[0]
                    </div>
                    <h4 class="fw-bold">@Model.User.FullName</h4>
                    <p class="text-muted mb-1">@Model.User.Email</p>
                    @if (Model.User.HandicapIndex.HasValue)
                    {
                        <span class="badge bg-success fs-6">Handicap @Model.User.HandicapIndex.Value.ToString("F1")</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.User.GhinNumber))
                    {
                        <p class="text-muted small mt-2">GHIN: @Model.User.GhinNumber</p>
                    }
                </div>
            </div>

            <!-- Club Memberships -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-bold">
                    <i class="bi bi-building me-2 text-success"></i>My Clubs
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var membership in Model.User.ClubMemberships.Where(m => m.IsActive))
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <a asp-page="/Club/Dashboard" asp-route-slug="@membership.Club.Slug" class="fw-bold text-decoration-none">
                                    @membership.Club.Name
                                </a>
                                <br><small class="text-muted">@membership.Role</small>
                            </div>
                            <small class="text-muted">@membership.JoinedAt.ToString("MMM yyyy")</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <!-- Edit Profile -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent fw-bold">
                    <i class="bi bi-pencil me-2 text-success"></i>Edit Profile
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FirstName" class="form-label">First Name</label>
                                <input asp-for="Input.FirstName" class="form-control" />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.LastName" class="form-label">Last Name</label>
                                <input asp-for="Input.LastName" class="form-control" />
                                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.City" class="form-label">City</label>
                                <input asp-for="Input.City" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.State" class="form-label">State</label>
                                <input asp-for="Input.State" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.HandicapIndex" class="form-label">Handicap Index</label>
                                <input asp-for="Input.HandicapIndex" class="form-control" step="0.1" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.GhinNumber" class="form-label">GHIN Number</label>
                                <input asp-for="Input.GhinNumber" class="form-control" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success mt-3">
                            <i class="bi bi-check-lg me-2"></i>Save Changes
                        </button>
                    </form>
                </div>
            </div>

            <!-- Recent Rounds -->
            @if (Model.RecentRounds.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent fw-bold d-flex justify-content-between">
                        <span><i class="bi bi-list-ol me-2 text-success"></i>Recent Rounds</span>
                        <a asp-page="/Player/Rounds" class="btn btn-sm btn-outline-success">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Event</th>
                                    <th>Course</th>
                                    <th>Score</th>
                                    <th>+/-</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var round in Model.RecentRounds)
                                {
                                    <tr>
                                        <td>@round.CompletedAt?.ToString("MMM d")</td>
                                        <td>@round.Event.Name</td>
                                        <td>@round.Course.Name</td>
                                        <td class="fw-bold">@round.GrossScore</td>
                                        <td>
                                            @{
                                                var toPar = round.GrossScore - round.Course.ParTotal;
                                            }
                                            <span class="@(toPar < 0 ? "text-danger" : toPar == 0 ? "text-success" : "text-secondary")">
                                                @(toPar > 0 ? $"+{toPar}" : toPar.ToString())
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
