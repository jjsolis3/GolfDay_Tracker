@page
@model GolfDay.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section bg-success text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="bi bi-flag-fill me-3"></i>GolfDay Tracker
                </h1>
                <p class="lead mb-4">
                    The complete golf management platform for clubs, leagues, and tournaments.
                    Track live scoring, manage events, and monitor standings — all in one place.
                </p>
                @if (!User.Identity!.IsAuthenticated)
                {
                    <a asp-page="/Account/Register" class="btn btn-warning btn-lg me-3">
                        <i class="bi bi-person-plus me-2"></i>Join Your Club
                    </a>
                    <a asp-page="/Account/Login" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                    </a>
                }
                else
                {
                    <a asp-page="/Events/Index" class="btn btn-warning btn-lg me-3">
                        <i class="bi bi-calendar-event me-2"></i>View Events
                    </a>
                    <a asp-page="/Player/Stats" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-graph-up me-2"></i>My Stats
                    </a>
                }
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <i class="bi bi-flag display-1 opacity-25"></i>
            </div>
        </div>
    </div>
</section>

<!-- Feature Cards -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Everything Your Club Needs</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-success bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                            <i class="bi bi-broadcast text-success fs-2"></i>
                        </div>
                        <h4 class="fw-bold">Live Scoring</h4>
                        <p class="text-muted">Real-time hole-by-hole score tracking with instant leaderboard updates during events.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-warning bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                            <i class="bi bi-trophy text-warning fs-2"></i>
                        </div>
                        <h4 class="fw-bold">Tournaments</h4>
                        <p class="text-muted">Full tournament management — registration, pairings, multi-round scoring, and results.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-info bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                            <i class="bi bi-people text-info fs-2"></i>
                        </div>
                        <h4 class="fw-bold">Season Leagues</h4>
                        <p class="text-muted">Head-to-head league play with automated scheduling, standings, and season-end tracking.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-danger bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                            <i class="bi bi-graph-up text-danger fs-2"></i>
                        </div>
                        <h4 class="fw-bold">Player Stats</h4>
                        <p class="text-muted">Handicap tracking, scoring averages, GIR, fairways, putts, and achievement records.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                            <i class="bi bi-building text-primary fs-2"></i>
                        </div>
                        <h4 class="fw-bold">Multi-Club</h4>
                        <p class="text-muted">Players can belong to multiple clubs. Clubs manage their own members, courses, and events independently.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-secondary bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                            <i class="bi bi-star text-secondary fs-2"></i>
                        </div>
                        <h4 class="fw-bold">Achievements</h4>
                        <p class="text-muted">Track longest drive, closest to the pin, hole-in-ones, low net, and other special recognitions.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recent Events -->
@if (Model.RecentEvents.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="fw-bold mb-4"><i class="bi bi-calendar-event me-2 text-success"></i>Recent & Upcoming Events</h2>
            <div class="row g-3">
                @foreach (var ev in Model.RecentEvents)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <span class="badge @(ev.Status == GolfDay.Domain.Enums.EventStatus.InProgress ? "bg-danger" : "bg-success") mb-2">
                                    @(ev.Status == GolfDay.Domain.Enums.EventStatus.InProgress ? "LIVE" : ev.Status.ToString())
                                </span>
                                <h5 class="card-title fw-bold">@ev.Name</h5>
                                <p class="text-muted small mb-1"><i class="bi bi-calendar me-1"></i>@ev.EventDate.ToString("MMM d, yyyy")</p>
                                <p class="text-muted small mb-1"><i class="bi bi-building me-1"></i>@ev.Club.Name</p>
                                @if (ev.Course != null)
                                {
                                    <p class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@ev.Course.Name</p>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a asp-page="/Events/Details" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-success w-100">
                                    View Event
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
