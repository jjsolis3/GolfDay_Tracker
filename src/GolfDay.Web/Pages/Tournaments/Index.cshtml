@page
@model GolfDay.Web.Pages.Tournaments.TournamentsIndexModel
@using GolfDay.Domain.Enums
@{
    ViewData["Title"] = "Tournaments";
}

@section Styles {
    <style>
        .tournament-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            transition: transform .2s, box-shadow .2s;
        }
        .tournament-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0,0,0,.13);
        }
        .nav-tabs .nav-link { font-size: .9rem; }
        .nav-tabs .nav-link.active { font-weight: 600; }
        .deadline-warning { font-size: .8rem; }
        .progress-bar-thin { height: 5px; border-radius: 4px; }
    </style>
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-trophy me-2 text-warning"></i>Tournaments
            </h1>
            <p class="text-muted mb-0">Compete in structured tournaments across all formats</p>
        </div>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "" ? "active" : "")"
               asp-page="/Tournaments/Index" asp-route-filter="">
                <i class="bi bi-list-ul me-1"></i>All
                <span class="badge bg-secondary ms-1">@Model.AllCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "registration" ? "active" : "")"
               asp-page="/Tournaments/Index" asp-route-filter="registration">
                <i class="bi bi-pencil-square me-1"></i>Registration Open
                @if (Model.RegistrationCount > 0)
                {
                    <span class="badge bg-primary ms-1">@Model.RegistrationCount</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "active" ? "active" : "")"
               asp-page="/Tournaments/Index" asp-route-filter="active">
                <i class="bi bi-broadcast me-1 text-danger"></i>Active
                @if (Model.ActiveCount > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.ActiveCount</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "completed" ? "active" : "")"
               asp-page="/Tournaments/Index" asp-route-filter="completed">
                <i class="bi bi-check2-circle me-1"></i>Completed
            </a>
        </li>
    </ul>

    @if (!Model.Tournaments.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-trophy display-1 text-muted opacity-25"></i>
            <h4 class="mt-3 text-muted">No Tournaments Found</h4>
            <p class="text-muted small">There are no tournaments matching the selected filter.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var t in Model.Tournaments)
            {
                var isActive   = t.Status == TournamentStatus.Active;
                var isReg      = t.Status == TournamentStatus.Registration;
                var isComplete = t.Status == TournamentStatus.Completed;
                var isCancelled = t.Status == TournamentStatus.Cancelled;
                var confirmedCount = t.Entries.Count(e => e.Status == EntryStatus.Confirmed || e.Status == EntryStatus.Registered);
                var spotsLeft = t.MaxParticipants - confirmedCount;
                var fillPct = t.MaxParticipants > 0 ? (double)confirmedCount / t.MaxParticipants * 100 : 0;

                <div class="col-lg-4 col-md-6">
                    <div class="card tournament-card h-100">
                        <!-- Card header with status -->
                        <div class="card-header border-0
                            @(isActive ? "bg-danger bg-opacity-10" : isReg ? "bg-primary bg-opacity-10" : isComplete ? "bg-light" : "bg-light")">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    @if (isActive)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-broadcast me-1"></i>Active
                                        </span>
                                    }
                                    else if (isReg)
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-pencil me-1"></i>Open
                                        </span>
                                    }
                                    else if (isComplete)
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-check-circle me-1"></i>Completed
                                        </span>
                                    }
                                    else if (isCancelled)
                                    {
                                        <span class="badge bg-dark">
                                            <i class="bi bi-x-circle me-1"></i>Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@t.Status</span>
                                    }
                                </div>
                                <span class="badge bg-white border text-dark small">@t.Format</span>
                            </div>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-1">@t.Name</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-building me-1 text-success"></i>@t.Club.Name
                                @if (t.Course != null)
                                {
                                    <span class="mx-1">·</span>
                                    <i class="bi bi-geo-alt me-1 text-success"></i>@t.Course.Name
                                }
                            </p>

                            <!-- Date range -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="flex-fill">
                                    <div class="small text-muted mb-1">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @t.StartDate.ToString("MMM d") – @t.EndDate.ToString("MMM d, yyyy")
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-flag me-1"></i>
                                        @t.NumberOfRounds round@(t.NumberOfRounds != 1 ? "s" : "") ·
                                        <i class="bi bi-people ms-1 me-1"></i>
                                        @confirmedCount / @t.MaxParticipants players
                                    </div>
                                </div>
                            </div>

                            <!-- Entry fill bar -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Entries</small>
                                    <small class="@(spotsLeft <= 5 && isReg ? "text-danger fw-bold" : "text-muted")">
                                        @(isReg && spotsLeft > 0 ? $"{spotsLeft} spots left" : $"{confirmedCount}/{t.MaxParticipants}")
                                    </small>
                                </div>
                                <div class="progress progress-bar-thin">
                                    <div class="progress-bar @(fillPct >= 90 ? "bg-danger" : fillPct >= 70 ? "bg-warning" : "bg-success")"
                                         style="width:@fillPct.ToString("F0")%"></div>
                                </div>
                            </div>

                            <!-- Registration deadline warning -->
                            @if (t.RegistrationDeadline.HasValue && isReg)
                            {
                                var daysLeft = (t.RegistrationDeadline.Value.Date - DateTime.Today).Days;
                                if (daysLeft >= 0)
                                {
                                    <div class="alert alert-warning py-1 px-2 mt-2 mb-0 deadline-warning">
                                        <i class="bi bi-clock me-1"></i>
                                        @if (daysLeft == 0)
                                        {
                                            <strong>Registration closes today!</strong>
                                        }
                                        else
                                        {
                                            <span>Registration closes in <strong>@daysLeft day@(daysLeft != 1 ? "s" : "")</strong></span>
                                        }
                                    </div>
                                }
                            }

                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <p class="text-muted small mt-2 mb-0"
                                   style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">
                                    @t.Description
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(t.Prizes))
                            {
                                <div class="mt-2">
                                    <small class="text-muted"><i class="bi bi-gift me-1 text-warning"></i>Prizes available</small>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                            <a asp-page="/Tournaments/Details" asp-route-id="@t.Id"
                               class="btn btn-sm btn-outline-success w-100">
                                <i class="bi bi-eye me-1"></i>View Tournament
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
