@page
@model GolfDay.Web.Pages.Events.EventsIndexModel
@{
    ViewData["Title"] = "Golf Events";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="fw-bold mb-1"><i class="bi bi-calendar-event me-2 text-success"></i>Golf Events</h1>
            <p class="text-muted mb-0">Browse upcoming and live events across all clubs</p>
        </div>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-tabs mb-4" id="eventTabs">
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "" ? "active" : "")"
               asp-page="/Events/Index" asp-route-filter="">
                <i class="bi bi-list-ul me-1"></i>All
                <span class="badge bg-secondary ms-1">@Model.AllCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "today" ? "active" : "")"
               asp-page="/Events/Index" asp-route-filter="today">
                <i class="bi bi-calendar-day me-1"></i>Today
                @if (Model.TodayCount > 0)
                {
                    <span class="badge bg-success ms-1">@Model.TodayCount</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "live" ? "active" : "")"
               asp-page="/Events/Index" asp-route-filter="live">
                <i class="bi bi-broadcast me-1 text-danger"></i>Live
                @if (Model.LiveCount > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.LiveCount</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "upcoming" ? "active" : "")"
               asp-page="/Events/Index" asp-route-filter="upcoming">
                <i class="bi bi-calendar-arrow-down me-1"></i>Upcoming
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == "completed" ? "active" : "")"
               asp-page="/Events/Index" asp-route-filter="completed">
                <i class="bi bi-check2-circle me-1"></i>Completed
            </a>
        </li>
    </ul>

    @if (!Model.Events.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted opacity-50"></i>
            <h4 class="mt-3 text-muted">No events found</h4>
            <p class="text-muted">There are no events matching the selected filter.</p>
        </div>
    }
    else
    {
        <!-- Live Events Banner -->
        @if (Model.LiveEvents.Any())
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 d-flex align-items-center" role="alert">
                <div class="me-3">
                    <span class="badge bg-danger fs-6 px-3 py-2 animate-pulse">
                        <i class="bi bi-broadcast me-1"></i>LIVE
                    </span>
                </div>
                <div class="flex-grow-1">
                    <strong>@Model.LiveEvents.Count event(s) currently in progress!</strong>
                    @foreach (var live in Model.LiveEvents.Take(3))
                    {
                        <a asp-page="/Scoring/Live" asp-route-eventId="@live.Id"
                           class="ms-3 text-danger fw-semibold text-decoration-none">
                            <i class="bi bi-arrow-right me-1"></i>@live.Name
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Events Grid -->
        <div class="row g-4">
            @foreach (var ev in Model.Events)
            {
                var isLive = ev.Status == EventStatus.InProgress;
                var isCompleted = ev.Status == EventStatus.Completed;
                var isToday = ev.EventDate.Date == DateTime.Today;

                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm @(isLive ? "border-start border-danger border-3" : "")">
                        <!-- Status Bar -->
                        <div class="card-header border-0 @(isLive ? "bg-danger bg-opacity-10" : isCompleted ? "bg-secondary bg-opacity-10" : isToday ? "bg-success bg-opacity-10" : "bg-light")">
                            <div class="d-flex align-items-center justify-content-between">
                                @if (isLive)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-broadcast me-1"></i>LIVE
                                    </span>
                                }
                                else if (isCompleted)
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-check-circle me-1"></i>Completed
                                    </span>
                                }
                                else if (ev.Status == EventStatus.Scheduled)
                                {
                                    <span class="badge @(isToday ? "bg-success" : "bg-primary")">
                                        <i class="bi bi-calendar-check me-1"></i>@(isToday ? "Today" : "Scheduled")
                                    </span>
                                }
                                else if (ev.Status == EventStatus.Cancelled)
                                {
                                    <span class="badge bg-dark">
                                        <i class="bi bi-x-circle me-1"></i>Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@ev.Status</span>
                                }
                                <small class="text-muted">@ev.EventDate.ToString("MMM d, yyyy")</small>
                            </div>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-2">@ev.Name</h5>

                            <div class="row g-2 mb-3">
                                <div class="col-12">
                                    <small class="text-muted d-flex align-items-center">
                                        <i class="bi bi-building me-2 text-success"></i>
                                        <span class="fw-medium text-dark">@ev.Club.Name</span>
                                    </small>
                                </div>
                                @if (ev.Course != null)
                                {
                                    <div class="col-12">
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="bi bi-geo-alt me-2 text-success"></i>@ev.Course.Name
                                        </small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ev.Format))
                                {
                                    <div class="col-12">
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="bi bi-diagram-3 me-2 text-success"></i>@ev.Format
                                        </small>
                                    </div>
                                }
                                <div class="col-12">
                                    <small class="text-muted d-flex align-items-center">
                                        <i class="bi bi-people me-2 text-success"></i>
                                        @ev.Participants.Count participant@(ev.Participants.Count != 1 ? "s" : "")
                                        <span class="ms-1 text-muted">/ @ev.MaxParticipants max</span>
                                    </small>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(ev.Description))
                            {
                                <p class="text-muted small mb-0" style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                                    @ev.Description
                                </p>
                            }
                        </div>

                        <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                            <div class="d-flex gap-2">
                                <a asp-page="/Events/Details" asp-route-id="@ev.Id"
                                   class="btn btn-sm btn-outline-success flex-grow-1">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                                @if (isLive)
                                {
                                    <a asp-page="/Scoring/Live" asp-route-eventId="@ev.Id"
                                       class="btn btn-sm btn-danger flex-grow-1">
                                        <i class="bi bi-broadcast me-1"></i>Live Scoring
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .animate-pulse {
            animation: pulse 1.5s ease-in-out infinite;
        }
        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        .nav-tabs .nav-link.active {
            font-weight: 600;
        }
    </style>
}
