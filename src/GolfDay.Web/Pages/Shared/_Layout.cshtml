@inject GolfDay.Web.Services.IClubAccessService _clubAccess
@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GolfDay Tracker</title>
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#198754" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GolfDay" />
    <link rel="apple-touch-icon" href="/images/icon-192.png" />
    <!-- Bootstrap 5 via CDN (replace with local files in production) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <i class="bi bi-flag-fill me-2"></i>GolfDay Tracker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    @{
                        bool _isMember = false;
                        if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && !User.IsInRole("ClubManager"))
                        {
                            var _uid = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            if (_uid != null) _isMember = await _clubAccess.HasActiveMembershipAsync(_uid);
                        }
                        else if (User.IsInRole("Admin") || User.IsInRole("ClubManager"))
                        {
                            _isMember = true;
                        }
                        bool _showClubFeatures = !User.Identity!.IsAuthenticated || _isMember;
                    }
                    <ul class="navbar-nav me-auto">
                        @if (_showClubFeatures)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Events/Index">
                                    <i class="bi bi-calendar-event me-1"></i>Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Tournaments/Index">
                                    <i class="bi bi-trophy me-1"></i>Tournaments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/League/Index">
                                    <i class="bi bi-people me-1"></i>Leagues
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Club/Leaderboard">
                                    <i class="bi bi-bar-chart me-1"></i>Standings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/TeeTime/Index">
                                    <i class="bi bi-clock me-1"></i>Tee Times
                                </a>
                            </li>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-page="/Club/Join">
                                    <i class="bi bi-building-add me-1"></i>Join a Club
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("ClubManager"))
                            {
                                <li class="nav-item me-2">
                                    <a class="nav-link" asp-area="Admin" asp-page="/Index">
                                        <i class="bi bi-gear-fill me-1"></i>Admin
                                    </a>
                                </li>
                            }
                            <li class="nav-item me-1">
                                <a class="nav-link position-relative" asp-page="/Notifications/Index" title="Notifications">
                                    <i class="bi bi-bell-fill fs-5"></i>
                                    <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                                          style="font-size:.65rem;">0</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="profile-avatar bg-white text-success rounded-circle d-inline-flex align-items-center justify-content-center me-2"
                                          style="width:28px;height:28px;font-size:0.8rem;font-weight:700;">
                                        @(User.Identity.Name?.Substring(0, 1)?.ToUpper() ?? "?")
                                    </span>
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><a class="dropdown-item" asp-page="/Account/Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-page="/Player/Stats"><i class="bi bi-graph-up me-2"></i>My Stats</a></li>
                                    <li><a class="dropdown-item" asp-page="/Player/Rounds"><i class="bi bi-list-ol me-2"></i>My Rounds</a></li>
                                    <li><a class="dropdown-item" asp-page="/TeeTime/Index"><i class="bi bi-clock me-2"></i>Tee Times</a></li>
                                    <li><a class="dropdown-item" asp-page="/Club/Join"><i class="bi bi-people me-2"></i>Join a Club</a></li>
                                    <li><a class="dropdown-item" asp-page="/Notifications/Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                                </a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-warning btn-sm px-3" asp-page="/Account/Register">Join Free</a>
                            </li>
                        }
                        <!-- Dark Mode Toggle -->
                        <li class="nav-item ms-2">
                            <button id="dark-mode-toggle" title="Toggle Dark Mode" aria-label="Toggle Dark Mode">
                                <i class="bi bi-moon-fill"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3 mb-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3 mb-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Live notification toast container -->
    <div id="live-notifications" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999"></div>

    <!-- Quick Actions FAB (authenticated users only) -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="fab-container" class="print-hide">
            <button id="fab-main" aria-label="Quick Actions" aria-expanded="false">
                <i class="bi bi-plus-lg"></i>
            </button>
            <div id="fab-actions" class="fab-actions" role="menu">
                <div class="fab-action-item">
                    <label>Post Score</label>
                    <a asp-page="/Rounds/Enter" class="fab-action-btn bg-success" title="Post a Round">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                </div>
                @if (_isMember)
                {
                    <div class="fab-action-item">
                        <label>Join Event</label>
                        <a asp-page="/Events/Index" asp-route-filter="upcoming" class="fab-action-btn bg-primary" title="Join Event">
                            <i class="bi bi-calendar-plus"></i>
                        </a>
                    </div>
                    <div class="fab-action-item">
                        <label>Book Tee Time</label>
                        <a asp-page="/TeeTime/Index" class="fab-action-btn bg-warning" title="Book Tee Time" style="color:#212529;">
                            <i class="bi bi-clock"></i>
                        </a>
                    </div>
                    <div class="fab-action-item">
                        <label>Report Conditions</label>
                        <a asp-page="/Club/Dashboard" class="fab-action-btn bg-info" title="Report Conditions" style="color:#212529;">
                            <i class="bi bi-cloud-sun"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="fab-action-item">
                        <label>Join a Club</label>
                        <a asp-page="/Club/Join" class="fab-action-btn bg-warning" title="Join a Club" style="color:#212529;">
                            <i class="bi bi-building-add"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <footer class="footer py-4 bg-dark text-white mt-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <span class="fw-bold"><i class="bi bi-flag-fill me-2 text-success"></i>GolfDay Tracker</span>
                    <span class="text-white ms-3">&copy; @DateTime.Now.Year — Built for Golf Clubs</span>
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="fw-bold"><i class="bi score-birdie me-2 text-success"></i>  |    crafted by <a href="https://www.instagram.com/774entfx/" class="text-white text-decoration-none small">@@774EntFx</a>    |  </span>
                </div>
                <div class="col-md-4 text-md-end">
                    <a href="#" class="text-white text-decoration-none small me-3">Privacy Policy</a>
                    <a href="#" class="text-white text-decoration-none small me-3">Terms of Use</a>
                    <a href="#" class="text-white text-decoration-none small">Contact</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
        }

        // PWA Install Prompt
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', e => {
            e.preventDefault();
            deferredPrompt = e;
            const btn = document.getElementById('pwa-install-btn');
            if (btn) btn.classList.remove('d-none');
        });
        function installPWA() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then(() => { deferredPrompt = null; });
            }
        }
    </script>
</body>
</html>
