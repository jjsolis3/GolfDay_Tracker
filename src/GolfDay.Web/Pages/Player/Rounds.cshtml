@page
@model GolfDay.Web.Pages.Player.RoundsModel
@{
    ViewData["Title"] = "My Rounds";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-list-ol me-2 text-success"></i>My Rounds</h2>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm w-auto" onchange="window.location='?year='+this.value+'&clubId=@Model.SelectedClubId'">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                }
            </select>
            @if (Model.Clubs.Count > 1)
            {
                <select class="form-select form-select-sm w-auto" onchange="window.location='?year=@Model.SelectedYear&clubId='+this.value">
                    <option value="">All Clubs</option>
                    @foreach (var club in Model.Clubs)
                    {
                        <option value="@club.Id" selected="@(club.Id == Model.SelectedClubId)">@club.Name</option>
                    }
                </select>
            }
        </div>
    </div>

    @if (!Model.Rounds.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-clipboard-x fs-1 text-muted mb-3 d-block"></i>
            <h5 class="text-muted">No rounds recorded for @Model.SelectedYear</h5>
        </div>
        return;
    }

    <!-- Summary row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card border-0 bg-light text-center p-3">
                <div class="fw-bold fs-4 text-success">@Model.Rounds.Count</div>
                <small class="text-muted">Rounds</small>
            </div>
        </div>
        @if (Model.Rounds.Any(r => r.GrossScore.HasValue))
        {
            <div class="col-6 col-md-2">
                <div class="card border-0 bg-light text-center p-3">
                    <div class="fw-bold fs-4 text-primary">@Model.Rounds.Where(r => r.GrossScore.HasValue).Average(r => r.GrossScore!.Value).ToString("F1")</div>
                    <small class="text-muted">Avg Score</small>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card border-0 bg-light text-center p-3">
                    <div class="fw-bold fs-4 text-warning">@Model.Rounds.Where(r => r.GrossScore.HasValue).Min(r => r.GrossScore!.Value)</div>
                    <small class="text-muted">Best Score</small>
                </div>
            </div>
        }
        <div class="col-6 col-md-2">
            <div class="card border-0 bg-light text-center p-3">
                <div class="fw-bold fs-4 text-danger">@Model.Rounds.Sum(r => r.Birdies ?? 0)</div>
                <small class="text-muted">Total Birdies</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Event</th>
                        <th>Course</th>
                        <th class="text-center">Gross</th>
                        <th class="text-center">+/-</th>
                        <th class="text-center">Net</th>
                        <th class="text-center">Birds</th>
                        <th class="text-center">Putts</th>
                        <th class="text-center">FH%</th>
                        <th class="text-center">GIR%</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var round in Model.Rounds)
                    {
                        var toPar = round.GrossScore.HasValue ? round.GrossScore.Value - (round.Course?.ParTotal ?? 72) : (int?)null;
                        var fairwayPct = round.FairwaysHit.HasValue && round.TotalFairways.HasValue && round.TotalFairways > 0
                            ? (double)round.FairwaysHit.Value / round.TotalFairways.Value * 100 : (double?)null;
                        var girPct = round.GreensInRegulation.HasValue && round.TotalGreens.HasValue && round.TotalGreens > 0
                            ? (double)round.GreensInRegulation.Value / round.TotalGreens.Value * 100 : (double?)null;

                        <tr>
                            <td class="text-nowrap">@round.CompletedAt?.ToString("MMM d, yyyy")</td>
                            <td>
                                <a asp-page="/Events/Details" asp-route-id="@round.EventId" class="text-decoration-none fw-semibold">
                                    @round.Event.Name
                                </a>
                            </td>
                            <td class="text-muted small">@round.Course?.Name</td>
                            <td class="text-center fw-bold">@(round.GrossScore?.ToString() ?? "-")</td>
                            <td class="text-center fw-bold @(toPar < 0 ? "score-eagle-text" : toPar == 0 ? "score-par-text" : "score-bogey-text")">
                                @if (toPar.HasValue) { @(toPar == 0 ? "E" : (toPar > 0 ? $"+{toPar}" : toPar.ToString())) }
                                else { <span>-</span> }
                            </td>
                            <td class="text-center text-muted">@(round.NetScore?.ToString() ?? "-")</td>
                            <td class="text-center text-warning">@(round.Birdies?.ToString() ?? "-")</td>
                            <td class="text-center">@(round.TotalPutts?.ToString() ?? "-")</td>
                            <td class="text-center small">@(fairwayPct?.ToString("F0") != null ? fairwayPct.Value.ToString("F0") + "%" : "-")</td>
                            <td class="text-center small">@(girPct?.ToString("F0") != null ? girPct.Value.ToString("F0") + "%" : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
