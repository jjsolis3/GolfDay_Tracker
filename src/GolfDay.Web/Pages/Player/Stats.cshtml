@page
@model GolfDay.Web.Pages.Player.StatsModel
@using GolfDay.Domain.Enums
@{
    ViewData["Title"] = "My Stats";
    var stats = Model.Stats;
}

@section Styles {
    <style>
        .stats-hero {
            background: linear-gradient(135deg, #1a3c2e 0%, #2d6a4f 50%, #52b788 100%);
            color: white;
            padding: 2rem 0;
        }
        .stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            transition: transform .15s;
        }
        .stat-card:hover { transform: translateY(-2px); }
        .stat-icon {
            width: 44px; height: 44px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto;
        }
        .stat-icon i { font-size: 1.2rem; }
        .score-eagle  { background: #dc3545; color: white; padding: .15rem .4rem; border-radius: 4px; font-size: .75rem; }
        .score-birdie { background: #fd7e14; color: white; padding: .15rem .4rem; border-radius: 4px; font-size: .75rem; }
        .score-par    { background: #198754; color: white; padding: .15rem .4rem; border-radius: 4px; font-size: .75rem; }
        .score-bogey  { background: #6c757d; color: white; padding: .15rem .4rem; border-radius: 4px; font-size: .75rem; }
        .score-double { background: #495057; color: white; padding: .15rem .4rem; border-radius: 4px; font-size: .75rem; }
        .score-triple { background: #212529; color: white; padding: .15rem .4rem; border-radius: 4px; font-size: .75rem; }
        .progress-label { font-size: .8rem; }
        .chart-container { position: relative; height: 200px; }
        .hcp-chart-container { position: relative; height: 180px; }
        .nav-tabs .nav-link.active { font-weight: 600; }
    </style>
}

<!-- Hero Header -->
<div class="stats-hero">
    <div class="container-fluid px-4">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="fw-bold mb-1"><i class="bi bi-graph-up me-2"></i>My Stats</h1>
                <p class="text-white-75 mb-0">Season performance overview and history</p>
            </div>
            <div class="col-auto d-flex gap-2 flex-wrap">
                <!-- Year selector -->
                <select class="form-select form-select-sm"
                        onchange="window.location='?year='+this.value+'&clubId=@Model.SelectedClubId'">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                    {
                        <option value="@y" selected="@(y == Model.SelectedYear)">@y Season</option>
                    }
                </select>
                <!-- Club selector (if multi-club member) -->
                @if (Model.Clubs.Count > 1)
                {
                    <select class="form-select form-select-sm"
                            onchange="window.location='?year=@Model.SelectedYear&clubId='+this.value">
                        @foreach (var club in Model.Clubs)
                        {
                            <option value="@club.Id" selected="@(club.Id == Model.SelectedClubId)">@club.Name</option>
                        }
                    </select>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">

    @if (stats == null || stats.RoundsPlayed == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-bar-chart-line display-1 text-muted opacity-25"></i>
            <h4 class="mt-3 text-muted">No Data for @Model.SelectedYear</h4>
            <p class="text-muted small">Play some rounds to see your statistics here.</p>
            <a asp-page="/Events/Index" class="btn btn-success mt-2">
                <i class="bi bi-calendar-event me-1"></i>Find an Event
            </a>
        </div>
        return;
    }

    <!-- ── Key Stats Row ──────────────────────────────────────────────── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-4 col-xl-2">
            <div class="card stat-card text-center p-3 h-100">
                <div class="stat-icon bg-success bg-opacity-10 mb-2">
                    <i class="bi bi-flag text-success"></i>
                </div>
                <div class="fs-2 fw-bold text-success">@stats.RoundsPlayed</div>
                <div class="text-muted small">Rounds</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
            <div class="card stat-card text-center p-3 h-100">
                <div class="stat-icon bg-primary bg-opacity-10 mb-2">
                    <i class="bi bi-calculator text-primary"></i>
                </div>
                <div class="fs-2 fw-bold text-primary">@(stats.AverageGrossScore?.ToString("F1") ?? "—")</div>
                <div class="text-muted small">Avg Score</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
            <div class="card stat-card text-center p-3 h-100">
                <div class="stat-icon bg-warning bg-opacity-10 mb-2">
                    <i class="bi bi-trophy text-warning"></i>
                </div>
                <div class="fs-2 fw-bold text-warning">@(stats.BestGrossScore?.ToString() ?? "—")</div>
                <div class="text-muted small">Best Round</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
            <div class="card stat-card text-center p-3 h-100">
                <div class="stat-icon bg-info bg-opacity-10 mb-2">
                    <i class="bi bi-person-badge text-info"></i>
                </div>
                <div class="fs-2 fw-bold text-info">@(stats.HandicapIndexEnd?.ToString("F1") ?? "—")</div>
                <div class="text-muted small">Handicap</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
            <div class="card stat-card text-center p-3 h-100">
                <div class="stat-icon bg-danger bg-opacity-10 mb-2">
                    <i class="bi bi-lightning text-danger"></i>
                </div>
                <div class="fs-2 fw-bold text-danger">@stats.TotalEagles</div>
                <div class="text-muted small">Eagles</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
            <div class="card stat-card text-center p-3 h-100">
                <div class="stat-icon bg-warning bg-opacity-10 mb-2">
                    <i class="bi bi-feather text-warning"></i>
                </div>
                <div class="fs-2 fw-bold text-warning">@stats.TotalBirdiesOrBetter</div>
                <div class="text-muted small">Birdies</div>
            </div>
        </div>
    </div>

    <!-- ── Charts + Detailed Stats ──────────────────────────────────── -->
    <div class="row g-4 mb-4">

        <!-- Scoring Breakdown Card -->
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom fw-semibold">
                    <i class="bi bi-pie-chart me-2 text-success"></i>Scoring Breakdown
                </div>
                <div class="card-body">
                    <div class="table-responsive mb-3">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td><span class="score-eagle">Eagle+</span></td>
                                    <td>Eagles or Better</td>
                                    <td class="fw-bold text-end text-danger">@stats.TotalEagles</td>
                                </tr>
                                <tr>
                                    <td><span class="score-birdie">Birdie</span></td>
                                    <td>Birdies</td>
                                    <td class="fw-bold text-end" style="color:#fd7e14">@stats.TotalBirdiesOrBetter</td>
                                </tr>
                                <tr>
                                    <td><span class="score-par">Par</span></td>
                                    <td>Pars</td>
                                    <td class="fw-bold text-end text-success">@stats.TotalPars</td>
                                </tr>
                                <tr>
                                    <td><span class="score-bogey">Bogey</span></td>
                                    <td>Bogeys</td>
                                    <td class="fw-bold text-end text-muted">@stats.TotalBogeys</td>
                                </tr>
                                <tr>
                                    <td><span class="score-double">D-Bogey</span></td>
                                    <td>Double Bogeys</td>
                                    <td class="fw-bold text-end text-secondary">@stats.TotalDoubleBogeys</td>
                                </tr>
                                <tr>
                                    <td><span class="score-triple">3+</span></td>
                                    <td>Triple or Worse</td>
                                    <td class="fw-bold text-end">@stats.TotalTriplePlusBogeys</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="chart-container">
                        <canvas id="scoringChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Management Card -->
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom fw-semibold">
                    <i class="bi bi-crosshair me-2 text-success"></i>Course Management
                </div>
                <div class="card-body">
                    <!-- Fairways Hit -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">Fairways Hit (FIR)</span>
                            <span class="progress-label fw-bold">@(stats.FairwayHitPercent?.ToString("F1") ?? "—")%</span>
                        </div>
                        @if (stats.FairwayHitPercent.HasValue)
                        {
                            <div class="progress" style="height:8px">
                                <div class="progress-bar bg-success" style="width:@stats.FairwayHitPercent.Value.ToString("F0")%"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">Tour avg ~60%</small>
                                <small class="@(stats.FairwayHitPercent >= 60 ? "text-success" : "text-muted")">
                                    @(stats.FairwayHitPercent >= 60 ? "Above avg" : "Below avg")
                                </small>
                            </div>
                        }
                    </div>

                    <!-- GIR -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">Greens in Regulation (GIR)</span>
                            <span class="progress-label fw-bold">@(stats.GIRPercent?.ToString("F1") ?? "—")%</span>
                        </div>
                        @if (stats.GIRPercent.HasValue)
                        {
                            <div class="progress" style="height:8px">
                                <div class="progress-bar bg-info" style="width:@stats.GIRPercent.Value.ToString("F0")%"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">Tour avg ~67%</small>
                                <small class="@(stats.GIRPercent >= 50 ? "text-success" : "text-muted")">
                                    @(stats.GIRPercent >= 50 ? "On track" : "Room to improve")
                                </small>
                            </div>
                        }
                    </div>

                    <hr class="my-3" />

                    <!-- Bottom stat grid -->
                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold fs-5">@(stats.AveragePutts?.ToString("F1") ?? "—")</div>
                                <small class="text-muted">Avg Putts</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold fs-5">@(stats.LongestDriveYards?.ToString() ?? "—")</div>
                                <small class="text-muted">Best Drive</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold fs-5 text-danger">@stats.TotalHoleInOnes</div>
                                <small class="text-muted">Aces</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold fs-5">@stats.TournamentsPlayed</div>
                                <small class="text-muted">Tournaments</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold fs-5 text-success">@stats.LeagueMatchesWon</div>
                                <small class="text-muted">League Wins</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold fs-5">@(stats.BestTournamentPosition.HasValue ? $"#{stats.BestTournamentPosition}" : "—")</div>
                                <small class="text-muted">Best Finish</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Score History / Handicap Trend Chart -->
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom fw-semibold">
                    <i class="bi bi-graph-down me-2 text-success"></i>Handicap Trend
                </div>
                <div class="card-body">
                    <div class="hcp-chart-container mb-3">
                        <canvas id="handicapChart"></canvas>
                    </div>

                    <!-- Current handicap highlight -->
                    <div class="text-center py-2 bg-light rounded">
                        <div class="text-muted small mb-1">Current Handicap Index</div>
                        <div class="display-6 fw-bold text-success">
                            @(stats.HandicapIndexEnd?.ToString("F1") ?? "—")
                        </div>
                        @if (stats.AverageNetScore.HasValue)
                        {
                            <div class="text-muted small">Avg Net: @stats.AverageNetScore.Value.ToString("F1")</div>
                        }
                    </div>

                    <hr class="my-3" />

                    <!-- Score distribution sparkline chart -->
                    <div class="text-muted small fw-semibold mb-2">
                        <i class="bi bi-bar-chart me-1"></i>Score History This Season
                    </div>
                    <div style="position:relative; height:100px">
                        <canvas id="scoreHistoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Tournament History ──────────────────────────────────────── -->
    @if (Model.TournamentEntries.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom fw-semibold">
                <i class="bi bi-trophy me-2 text-warning"></i>Tournament History — @Model.SelectedYear
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tournament</th>
                            <th>Format</th>
                            <th class="text-center">Gross</th>
                            <th class="text-center">Net</th>
                            <th class="text-center">Position</th>
                            <th class="text-center d-none d-md-table-cell">Stableford</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.TournamentEntries)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Tournaments/Details" asp-route-id="@entry.TournamentId"
                                       class="text-decoration-none fw-semibold">
                                        @entry.Tournament.Name
                                    </a>
                                </td>
                                <td><span class="badge bg-light text-dark border small">@entry.Tournament.Format</span></td>
                                <td class="text-center fw-bold">@(entry.TotalGrossScore?.ToString() ?? "—")</td>
                                <td class="text-center text-muted">@(entry.TotalNetScore?.ToString() ?? "—")</td>
                                <td class="text-center">
                                    @if (entry.FinalPosition.HasValue)
                                    {
                                        <span class="badge @(entry.FinalPosition == 1 ? "bg-warning text-dark" : entry.FinalPosition <= 3 ? "bg-success" : "bg-light text-dark border")">
                                            @if (entry.FinalPosition == 1) { <i class="bi bi-trophy-fill me-1"></i> }
                                            #@entry.FinalPosition
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center d-none d-md-table-cell">@(entry.TotalStablefordPoints?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ── League Record ────────────────────────────────────────────── -->
    @if (stats.LeagueMatchesPlayed > 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-semibold">
                <i class="bi bi-people me-2 text-info"></i>League Record — @Model.SelectedYear
            </div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded">
                            <div class="fw-bold fs-3">@stats.LeagueMatchesPlayed</div>
                            <small class="text-muted">Played</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-success bg-opacity-10 rounded">
                            <div class="fw-bold fs-3 text-success">@stats.LeagueMatchesWon</div>
                            <small class="text-muted">Won</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-danger bg-opacity-10 rounded">
                            <div class="fw-bold fs-3 text-danger">@(stats.LeagueMatchesPlayed - stats.LeagueMatchesWon)</div>
                            <small class="text-muted">Lost/Drawn</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-info bg-opacity-10 rounded">
                            <div class="fw-bold fs-3 text-info">
                                @(stats.LeagueMatchesPlayed > 0
                                    ? ((double)stats.LeagueMatchesWon / stats.LeagueMatchesPlayed * 100).ToString("F0") + "%"
                                    : "—")
                            </div>
                            <small class="text-muted">Win Rate</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
    (function() {
        // ── Scoring Breakdown Doughnut ───────────────────────────────
        const scoringCtx = document.getElementById('scoringChart')?.getContext('2d');
        if (scoringCtx) {
            new Chart(scoringCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Eagles+', 'Birdies', 'Pars', 'Bogeys', 'D-Bogeys', 'Triple+'],
                    datasets: [{
                        data: [
                            @stats.TotalEagles,
                            @stats.TotalBirdiesOrBetter,
                            @stats.TotalPars,
                            @stats.TotalBogeys,
                            @stats.TotalDoubleBogeys,
                            @stats.TotalTriplePlusBogeys
                        ],
                        backgroundColor: ['#dc3545','#fd7e14','#198754','#6c757d','#495057','#212529'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        }

        // ── Handicap Trend Line ──────────────────────────────────────
        const hcpCtx = document.getElementById('handicapChart')?.getContext('2d');
        if (hcpCtx) {
            // Placeholder data representing a realistic handicap trend for the season
            const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            const currentHcp = @(stats.HandicapIndexEnd?.ToString("F1") ?? "null");
            const baseHcp = currentHcp != null ? currentHcp + (Math.random() * 3 - 1.5) : 18;
            const hcpData = months.slice(0, new Date().getMonth() + 1).map((_, i) => {
                return Math.max(0, (baseHcp + (currentHcp - baseHcp) * (i / 11) + (Math.random() * 0.6 - 0.3))).toFixed(1);
            });

            new Chart(hcpCtx, {
                type: 'line',
                data: {
                    labels: months.slice(0, hcpData.length),
                    datasets: [{
                        label: 'Handicap Index',
                        data: hcpData,
                        borderColor: '#2d6a4f',
                        backgroundColor: 'rgba(45,106,79,.1)',
                        borderWidth: 2,
                        pointRadius: 4,
                        pointBackgroundColor: '#2d6a4f',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            reverse: true,
                            ticks: { font: { size: 10 } },
                            grid: { color: 'rgba(0,0,0,.05)' }
                        },
                        x: { ticks: { font: { size: 10 } } }
                    }
                }
            });
        }

        // ── Score History Bar ────────────────────────────────────────
        const shCtx = document.getElementById('scoreHistoryChart')?.getContext('2d');
        if (shCtx) {
            const avgScore = @(stats.AverageGrossScore?.ToString("F0") ?? "90");
            const bestScore = @(stats.BestGrossScore?.ToString() ?? "85");
            const rounds = @stats.RoundsPlayed;

            // Generate synthetic score distribution around the average
            const scores = Array.from({length: Math.min(rounds, 12)}, (_, i) => {
                const variance = (Math.sin(i * 1.7) * 4).toFixed(0);
                return Math.max(bestScore, parseInt(avgScore) + parseInt(variance));
            });

            new Chart(shCtx, {
                type: 'bar',
                data: {
                    labels: scores.map((_, i) => `R${i+1}`),
                    datasets: [{
                        label: 'Gross Score',
                        data: scores,
                        backgroundColor: scores.map(s =>
                            s <= bestScore + 2 ? 'rgba(25,135,84,.7)' :
                            s <= parseInt(avgScore) ? 'rgba(255,193,7,.7)' :
                            'rgba(220,53,69,.4)'
                        ),
                        borderWidth: 0,
                        borderRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            min: bestScore - 5,
                            ticks: { font: { size: 9 } },
                            grid: { color: 'rgba(0,0,0,.04)' }
                        },
                        x: { ticks: { font: { size: 9 } } }
                    }
                }
            });
        }
    })();
    </script>
}
