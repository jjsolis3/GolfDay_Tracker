@page
@model GolfDay.Web.Areas.Admin.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Manage Courses";
    // uses main layout via _ViewStart
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-map me-2 text-success"></i>Golf Courses</h2>
        <p class="text-muted mb-0">Manage all courses independently of club membership.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Import" class="btn btn-outline-secondary">
            <i class="bi bi-upload me-1"></i>Import CSV
        </a>
        <a asp-page="ApiSearch" class="btn btn-outline-success">
            <i class="bi bi-cloud-download me-1"></i>Search API
        </a>
        <a asp-page="Edit" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i>Add Course
        </a>
    </div>
</div>

<!-- Filters -->
<form method="get" class="row g-2 mb-4">
    <div class="col-sm-5">
        <input type="text" asp-for="Search" class="form-control" placeholder="Search by name, city, or state…" />
    </div>
    <div class="col-sm-4">
        <select asp-for="ClubFilter" class="form-select">
            <option value="">All Courses</option>
            <option value="public">Public / Standalone</option>
            @foreach (var club in Model.Clubs)
            {
                <option value="@club.Id">@club.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search me-1"></i>Filter</button>
        <a asp-page="Index" class="btn btn-outline-secondary ms-1">Clear</a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">@Model.Courses.Count course@(Model.Courses.Count != 1 ? "s" : "")</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Course</th>
                    <th>Location</th>
                    <th class="text-center">Holes</th>
                    <th class="text-center">Par</th>
                    <th class="text-center">Rating / Slope</th>
                    <th>Managed By</th>
                    <th class="text-center">Visibility</th>
                    <th class="text-center">Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr class="@(!course.IsActive ? "text-muted" : "")">
                        <td class="fw-medium">
                            @course.Name
                        </td>
                        <td class="small">@course.City@(!string.IsNullOrEmpty(course.State) ? $", {course.State}" : "")</td>
                        <td class="text-center">@course.NumberOfHoles</td>
                        <td class="text-center fw-bold">@course.ParTotal</td>
                        <td class="text-center small">
                            @(course.CourseRating?.ToString("F1") ?? "—") /
                            @(course.SlopeRating?.ToString("F0") ?? "—")
                        </td>
                        <td class="small">
                            @if (course.Club != null)
                            {
                                <span>@course.Club.Name</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Public</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (course.IsPublic)
                            {
                                <span class="badge bg-success">Public</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Private</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (course.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Inactive</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@course.Id" />
                                <button asp-page-handler="ToggleActive" class="btn btn-sm @(course.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(course.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi @(course.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                                <button asp-page-handler="Delete" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete course @course.Name? This cannot be undone.')"
                                        title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
