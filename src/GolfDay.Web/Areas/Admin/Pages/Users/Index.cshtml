@page
@model GolfDay.Web.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                    <li class="breadcrumb-item active">Users</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">
                <i class="bi bi-people me-2 text-secondary"></i>User Management
            </h1>
        </div>
        <div>
            <span class="text-muted">
                <i class="bi bi-person-check me-1"></i>
                @Model.TotalActive active of @Model.TotalUsers total users
            </span>
        </div>
    </div>

    <!-- Search / Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-sm-6 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.Search"
                               class="form-control border-start-0"
                               placeholder="Search by name or email..." />
                    </div>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Users</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="clubFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Clubs</option>
                        @foreach (var club in Model.Clubs)
                        {
                            <option value="@club.Id" selected="@(Model.ClubFilter == club.Id)">@club.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-page="Index" class="btn btn-link text-muted">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold">
                Users
                <span class="badge bg-secondary rounded-pill ms-2">@Model.Users.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Email</th>
                                <th>Handicap</th>
                                <th>Clubs</th>
                                <th>Roles</th>
                                <th>Joined</th>
                                <th>Last Login</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                var memberships = Model.UserMemberships.GetValueOrDefault(user.Id, new());
                                var roles = Model.UserRoles.GetValueOrDefault(user.Id, new());

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                            {
                                                <img src="@user.ProfilePictureUrl" alt="@user.FullName"
                                                     class="rounded-circle"
                                                     style="width:36px;height:36px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center"
                                                     style="width:36px;height:36px;min-width:36px;">
                                                    <i class="bi bi-person text-secondary"></i>
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-semibold">@user.FullName</div>
                                                <div class="text-muted small">@@user.UserName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted small">
                                        <a href="mailto:@user.Email" class="text-decoration-none text-muted">
                                            @user.Email
                                        </a>
                                        @if (user.EmailConfirmed)
                                        {
                                            <i class="bi bi-patch-check-fill text-success ms-1" title="Email confirmed"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-exclamation-circle text-warning ms-1" title="Email not confirmed"></i>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (user.HandicapIndex.HasValue)
                                        {
                                            @user.HandicapIndex.Value.ToString("F1")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (memberships.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var m in memberships.Take(3))
                                                {
                                                    <span class="badge bg-success bg-opacity-15 text-success rounded-pill small">
                                                        @m.Club?.Name
                                                    </span>
                                                }
                                                @if (memberships.Count > 3)
                                                {
                                                    <span class="badge bg-light text-dark border rounded-pill small">
                                                        +@(memberships.Count - 3) more
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">No clubs</span>
                                        }
                                    </td>
                                    <td>
                                        @if (roles.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var role in roles)
                                                {
                                                    var roleBadge = role switch
                                                    {
                                                        "Admin"        => "bg-danger",
                                                        "ClubManager"  => "bg-warning text-dark",
                                                        _              => "bg-secondary"
                                                    };
                                                    <span class="badge @roleBadge rounded-pill small">@role</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill small">Member</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @user.CreatedAt.ToString("MMM d, yyyy")
                                    </td>
                                    <td class="text-muted small">
                                        @(user.LastLoginAt.HasValue
                                            ? user.LastLoginAt.Value.ToString("MMM d, yyyy")
                                            : "Never")
                                    </td>
                                    <td class="text-center">
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="dropdown">
                                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                                    type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-area="Admin" asp-page="/Users/Details"
                                                       asp-route-id="@user.Id">
                                                        <i class="bi bi-person me-2"></i>View Profile
                                                    </a>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="ToggleStatus">
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        <button type="submit" class="dropdown-item">
                                                            @if (user.IsActive)
                                                            {
                                                                <i class="bi bi-person-slash me-2 text-danger"></i>
                                                                <span>Deactivate</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-person-check me-2 text-success"></i>
                                                                <span>Activate</span>
                                                            }
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination summary -->
                @if (Model.TotalUsers > Model.Users.Count)
                {
                    <div class="px-4 py-3 border-top text-muted small">
                        Showing @Model.Users.Count of @Model.TotalUsers users.
                        <a asp-page="Index" asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-clubFilter="@Model.ClubFilter"
                           asp-route-showAll="true" class="ms-2">Show all</a>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-people fs-1 opacity-25 d-block mb-3"></i>
                    <p class="mb-0">No users found matching your criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
