@page
@model GolfDay.Web.Areas.Admin.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Manage Events";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                    @if (Model.FilterClub != null)
                    {
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Clubs/Index">Clubs</a></li>
                        <li class="breadcrumb-item">
                            <a asp-area="Admin" asp-page="/Clubs/Manage" asp-route-id="@Model.FilterClub.Id">
                                @Model.FilterClub.Name
                            </a>
                        </li>
                    }
                    <li class="breadcrumb-item active">Events</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">
                <i class="bi bi-calendar-event me-2 text-primary"></i>
                @(Model.FilterClub != null ? $"{Model.FilterClub.Name} – Events" : "All Events")
            </h1>
        </div>
        <a asp-area="Admin" asp-page="/Events/Create"
           asp-route-clubId="@Model.ClubId"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Create Event
        </a>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                @if (Model.ClubId.HasValue)
                {
                    <input type="hidden" name="clubId" value="@Model.ClubId" />
                }
                <div class="col-sm-6 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.Search"
                               class="form-control border-start-0" placeholder="Search events..." />
                    </div>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<EventStatus>())
                        {
                            <option value="@s" selected="@(Model.StatusFilter == s.ToString())">@s</option>
                        }
                    </select>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="typeFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Types</option>
                        @foreach (var t in Enum.GetValues<EventType>())
                        {
                            <option value="@t" selected="@(Model.TypeFilter == t.ToString())">@t</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-page="Index" asp-route-clubId="@Model.ClubId" class="btn btn-link text-muted">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Events Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold">
                Events
                <span class="badge bg-primary rounded-pill ms-2">@Model.Events.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Events.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Event Name</th>
                                @if (!Model.ClubId.HasValue)
                                {
                                    <th>Club</th>
                                }
                                <th>Date</th>
                                <th>Type</th>
                                <th class="text-center">Participants</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model.Events)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@ev.Name</div>
                                        @if (!string.IsNullOrEmpty(ev.Format))
                                        {
                                            <div class="text-muted small">@ev.Format</div>
                                        }
                                    </td>
                                    @if (!Model.ClubId.HasValue)
                                    {
                                        <td class="text-muted small">@ev.Club?.Name</td>
                                    }
                                    <td class="text-muted small">
                                        <div>@ev.EventDate.ToString("MMM d, yyyy")</div>
                                        <div class="text-muted">@ev.EventDate.ToString("h:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-15 text-secondary rounded-pill">
                                            @ev.EventType
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @ev.Participants.Count / @ev.MaxParticipants
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var (badgeClass, icon) = ev.Status switch
                                            {
                                                EventStatus.Draft       => ("bg-light text-dark border", "bi-pencil"),
                                                EventStatus.Scheduled   => ("bg-primary",   "bi-calendar-check"),
                                                EventStatus.InProgress  => ("bg-success",   "bi-play-circle"),
                                                EventStatus.Completed   => ("bg-secondary", "bi-check-circle"),
                                                EventStatus.Cancelled   => ("bg-danger",    "bi-x-circle"),
                                                EventStatus.Postponed   => ("bg-warning",   "bi-pause-circle"),
                                                _                       => ("bg-light text-dark", "bi-circle")
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill">
                                            <i class="bi @icon me-1"></i>@ev.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-area="Admin" asp-page="/Events/Edit"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-area="Admin" asp-page="/Events/Scoring"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-outline-success" title="Manage Scoring">
                                                <i class="bi bi-123 me-1"></i>Scoring
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 opacity-25 d-block mb-3"></i>
                    <p class="mb-2">No events found.</p>
                    <a asp-area="Admin" asp-page="/Events/Create"
                       asp-route-clubId="@Model.ClubId"
                       class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Create First Event
                    </a>
                </div>
            }
        </div>
    </div>
</div>
