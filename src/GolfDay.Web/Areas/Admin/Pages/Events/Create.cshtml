@page
@model GolfDay.Web.Areas.Admin.Pages.Events.CreateModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-4" style="max-width:800px;">
    <!-- Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Events/Index">Events</a></li>
                <li class="breadcrumb-item active">Create</li>
            </ol>
        </nav>
        <h1 class="h2 fw-bold mb-0">
            <i class="bi bi-plus-circle me-2 text-primary"></i>Create New Event
        </h1>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Event Details</h5>
            </div>
            <div class="card-body">
                <!-- Club -->
                <div class="mb-3">
                    <label asp-for="Input.ClubId" class="form-label fw-semibold">Club <span class="text-danger">*</span></label>
                    <select asp-for="Input.ClubId" asp-items="Model.ClubSelectList"
                            class="form-select" id="clubSelect">
                        <option value="">— Select Club —</option>
                    </select>
                    <span asp-validation-for="Input.ClubId" class="text-danger small"></span>
                </div>

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label fw-semibold">Event Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.Name" class="form-control" placeholder="e.g. Club Championship Round 1" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"
                              placeholder="Optional event description..."></textarea>
                </div>

                <!-- Type + Format -->
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Input.EventType" class="form-label fw-semibold">Event Type <span class="text-danger">*</span></label>
                        <select asp-for="Input.EventType" class="form-select">
                            @foreach (var t in Enum.GetValues<EventType>())
                            {
                                <option value="@((int)t)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.Format" class="form-label fw-semibold">Format</label>
                        <input asp-for="Input.Format" class="form-control"
                               placeholder="e.g. Stroke Play, Match Play" />
                    </div>
                </div>

                <!-- Date + End Date -->
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Input.EventDate" class="form-label fw-semibold">Event Date &amp; Time <span class="text-danger">*</span></label>
                        <input asp-for="Input.EventDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Input.EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.EndDate" class="form-label fw-semibold">End Date <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="Input.EndDate" type="datetime-local" class="form-control" />
                    </div>
                </div>

                <!-- Course -->
                <div class="mb-3">
                    <label asp-for="Input.CourseId" class="form-label fw-semibold">Course</label>
                    <select asp-for="Input.CourseId" asp-items="Model.CourseSelectList" class="form-select">
                        <option value="">— No specific course —</option>
                    </select>
                    <div class="form-text">Select a club first to see available courses.</div>
                </div>

                <!-- Max Participants -->
                <div class="mb-3">
                    <label asp-for="Input.MaxParticipants" class="form-label fw-semibold">Max Participants</label>
                    <input asp-for="Input.MaxParticipants" type="number" class="form-control"
                           min="1" max="999" style="max-width:180px;" />
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-sliders me-2 text-secondary"></i>Options</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsPublic" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.IsPublic" class="form-check-label fw-semibold">Public Event</label>
                            <div class="form-text">Visible to all users on the site.</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-check form-switch">
                            <input asp-for="Input.UseHandicaps" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.UseHandicaps" class="form-check-label fw-semibold">Use Handicaps</label>
                            <div class="form-text">Apply handicap adjustments to scores.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i>Create Event
            </button>
            <a asp-area="Admin" asp-page="/Events/Index" class="btn btn-outline-secondary">
                <i class="bi bi-x me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
