@page
@model IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-speedometer2 me-2 text-success"></i>Admin Dashboard</h1>
            <p class="text-muted mb-0">System overview and quick access to management tools.</p>
        </div>
        <span class="text-muted small"><i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-success bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-buildings fs-3 text-success"></i>
                        </div>
                        <div>
                            <div class="fs-2 fw-bold text-success">@Model.TotalClubs</div>
                            <div class="text-muted small fw-semibold text-uppercase tracking-wide">Total Clubs</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-area="Admin" asp-page="/Clubs/Index" class="text-success small text-decoration-none">
                        <i class="bi bi-arrow-right me-1"></i>Manage Clubs
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-calendar-event fs-3 text-primary"></i>
                        </div>
                        <div>
                            <div class="fs-2 fw-bold text-primary">@Model.ActiveEvents</div>
                            <div class="text-muted small fw-semibold text-uppercase tracking-wide">Active Events</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-area="Admin" asp-page="/Events/Index" class="text-primary small text-decoration-none">
                        <i class="bi bi-arrow-right me-1"></i>Manage Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-info bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-people fs-3 text-info"></i>
                        </div>
                        <div>
                            <div class="fs-2 fw-bold text-info">@Model.TotalMembers</div>
                            <div class="text-muted small fw-semibold text-uppercase tracking-wide">Total Members</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-area="Admin" asp-page="/Users/Index" class="text-info small text-decoration-none">
                        <i class="bi bi-arrow-right me-1"></i>Manage Users
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-warning bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-diagram-3 fs-3 text-warning"></i>
                        </div>
                        <div>
                            <div class="fs-2 fw-bold text-warning">@Model.ActiveLeagues</div>
                            <div class="text-muted small fw-semibold text-uppercase tracking-wide">Active Leagues</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-area="Admin" asp-page="/League/Index" class="text-warning small text-decoration-none">
                        <i class="bi bi-arrow-right me-1"></i>Manage Leagues
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Events -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-calendar-week me-2 text-primary"></i>Recent Events</h5>
                    <a asp-area="Admin" asp-page="/Events/Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentEvents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Event</th>
                                        <th>Club</th>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Participants</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ev in Model.RecentEvents)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-semibold">@ev.Name</td>
                                            <td class="text-muted">@ev.Club?.Name</td>
                                            <td class="text-muted small">@ev.EventDate.ToString("MMM d, yyyy")</td>
                                            <td>
                                                <span class="badge bg-secondary bg-opacity-15 text-secondary rounded-pill">
                                                    @ev.EventType.ToString()
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">
                                                    @ev.Participants.Count / @ev.MaxParticipants
                                                </span>
                                            </td>
                                            <td>
                                                @{
                                                    var (badgeClass, icon) = ev.Status switch
                                                    {
                                                        EventStatus.Scheduled  => ("bg-primary",  "bi-calendar-check"),
                                                        EventStatus.InProgress => ("bg-success",  "bi-play-circle"),
                                                        EventStatus.Completed  => ("bg-secondary","bi-check-circle"),
                                                        EventStatus.Cancelled  => ("bg-danger",   "bi-x-circle"),
                                                        EventStatus.Postponed  => ("bg-warning",  "bi-pause-circle"),
                                                        _                      => ("bg-light text-dark", "bi-circle")
                                                    };
                                                }
                                                <span class="badge @badgeClass rounded-pill">
                                                    <i class="bi @icon me-1"></i>@ev.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 opacity-25 d-block mb-2"></i>
                            No recent events found.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Links -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-lightning me-2 text-warning"></i>Quick Actions</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a asp-area="Admin" asp-page="/Clubs/Index"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <span class="bg-success bg-opacity-10 rounded-2 p-2">
                            <i class="bi bi-buildings text-success fs-5"></i>
                        </span>
                        <div>
                            <div class="fw-semibold">Manage Clubs</div>
                            <div class="text-muted small">View, edit and configure clubs</div>
                        </div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                    <a asp-area="Admin" asp-page="/Events/Index"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <span class="bg-primary bg-opacity-10 rounded-2 p-2">
                            <i class="bi bi-calendar-event text-primary fs-5"></i>
                        </span>
                        <div>
                            <div class="fw-semibold">Manage Events</div>
                            <div class="text-muted small">Create and manage golf events</div>
                        </div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                    <a asp-area="Admin" asp-page="/Tournaments/Index"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <span class="bg-warning bg-opacity-10 rounded-2 p-2">
                            <i class="bi bi-trophy text-warning fs-5"></i>
                        </span>
                        <div>
                            <div class="fw-semibold">Manage Tournaments</div>
                            <div class="text-muted small">Oversee tournament brackets</div>
                        </div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                    <a asp-area="Admin" asp-page="/League/Index"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <span class="bg-info bg-opacity-10 rounded-2 p-2">
                            <i class="bi bi-diagram-3 text-info fs-5"></i>
                        </span>
                        <div>
                            <div class="fw-semibold">Manage Leagues</div>
                            <div class="text-muted small">Seasons, schedules and standings</div>
                        </div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                    <a asp-area="Admin" asp-page="/Users/Index"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <span class="bg-secondary bg-opacity-10 rounded-2 p-2">
                            <i class="bi bi-people text-secondary fs-5"></i>
                        </span>
                        <div>
                            <div class="fw-semibold">Manage Users</div>
                            <div class="text-muted small">User accounts and roles</div>
                        </div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                </div>
            </div>

            <!-- Summary Totals -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-success"></i>System Totals</h5>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-trophy me-2"></i>Total Tournaments</span>
                        <span class="badge bg-warning text-dark rounded-pill fs-6">@Model.TotalTournaments</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-diagram-3 me-2"></i>Total League Seasons</span>
                        <span class="badge bg-info rounded-pill fs-6">@Model.TotalLeagueSeasons</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-geo-alt me-2"></i>Total Courses</span>
                        <span class="badge bg-success rounded-pill fs-6">@Model.TotalCourses</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-card-list me-2"></i>Total Rounds Played</span>
                        <span class="badge bg-secondary rounded-pill fs-6">@Model.TotalRounds</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
