@page "{id:int}"
@model GolfDay.Web.Areas.Admin.Pages.Clubs.SponsorsModel
@using GolfDay.Domain.Enums
@{
    ViewData["Title"] = $"Sponsors – {Model.Club?.Name}";

    string TierBadgeClass(SponsorTier tier) => tier switch
    {
        SponsorTier.Title     => "bg-purple text-white",
        SponsorTier.Gold      => "bg-warning text-dark",
        SponsorTier.Silver    => "bg-secondary",
        SponsorTier.Bronze    => "bg-orange text-white",
        SponsorTier.Community => "bg-info text-white",
        _                     => "bg-secondary"
    };

    string TierIconClass(SponsorTier tier) => tier switch
    {
        SponsorTier.Title     => "bi-star-fill",
        SponsorTier.Gold      => "bi-trophy-fill",
        SponsorTier.Silver    => "bi-award-fill",
        SponsorTier.Bronze    => "bi-patch-check-fill",
        SponsorTier.Community => "bi-heart-fill",
        _                     => "bi-building"
    };

    var grouped = Model.Sponsors
        .GroupBy(s => s.Tier)
        .OrderByDescending(g => g.Key)
        .ToList();
}

@section Styles {
    <style>
        .bg-purple  { background-color: #6f42c1 !important; }
        .bg-orange  { background-color: #fd7e14 !important; }
        .sponsor-card { transition: transform .15s, box-shadow .15s; }
        .sponsor-card:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.12) !important; }
        .sponsor-logo-wrap {
            width: 80px; height: 60px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 8px; overflow: hidden;
            background: #f8f9fa;
            flex-shrink: 0;
        }
        .sponsor-logo-wrap img { max-width: 100%; max-height: 100%; object-fit: contain; }
    </style>
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Clubs/Index">Clubs</a></li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-page="/Clubs/Manage" asp-route-id="@Model.Id">@Model.Club?.Name</a>
                    </li>
                    <li class="breadcrumb-item active">Sponsors</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">
                <i class="bi bi-building me-2 text-warning"></i>Sponsors
            </h1>
            <p class="text-muted mb-0 mt-1">
                @Model.Sponsors.Count sponsor(s) for @Model.Club?.Name
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-page="/Clubs/Manage" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Manage
            </a>
            <button type="button" class="btn btn-warning text-dark"
                    data-bs-toggle="modal" data-bs-target="#addSponsorModal">
                <i class="bi bi-plus-lg me-1"></i>Add Sponsor
            </button>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tier summary pills -->
    @if (Model.Sponsors.Any())
    {
        <div class="d-flex gap-2 mb-4 flex-wrap">
            @foreach (var tier in Enum.GetValues<SponsorTier>().OrderByDescending(t => t))
            {
                var count = Model.Sponsors.Count(s => s.Tier == tier);
                if (count > 0)
                {
                    <span class="badge @TierBadgeClass(tier) rounded-pill fs-6 px-3 py-2">
                        <i class="bi @TierIconClass(tier) me-1"></i>@tier <span class="ms-1 opacity-75">@count</span>
                    </span>
                }
            }
        </div>
    }

    <!-- Sponsors by Tier -->
    @if (!Model.Sponsors.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-building fs-1 text-muted opacity-25 d-block mb-3"></i>
                <h5 class="text-muted">No sponsors yet</h5>
                <p class="text-muted mb-4">Add sponsors to display them on club and event pages.</p>
                <button type="button" class="btn btn-warning text-dark"
                        data-bs-toggle="modal" data-bs-target="#addSponsorModal">
                    <i class="bi bi-plus-lg me-1"></i>Add First Sponsor
                </button>
            </div>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <div class="mb-5">
                <h4 class="fw-semibold mb-3 d-flex align-items-center gap-2">
                    <span class="badge @TierBadgeClass(group.Key) rounded-pill px-3 py-2 fs-6">
                        <i class="bi @TierIconClass(group.Key) me-1"></i>@group.Key Tier
                    </span>
                    <span class="text-muted fs-6 fw-normal">@group.Count() sponsor(s)</span>
                </h4>
                <div class="row g-3">
                    @foreach (var sponsor in group.OrderBy(s => s.Name))
                    {
                        <div class="col-sm-6 col-xl-4">
                            <div class="card border-0 shadow-sm sponsor-card h-100 @(!sponsor.IsActive ? "opacity-60" : "")">
                                <div class="card-body">
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="sponsor-logo-wrap">
                                            @if (!string.IsNullOrEmpty(sponsor.LogoUrl))
                                            {
                                                <img src="@sponsor.LogoUrl" alt="@sponsor.Name logo" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-building fs-2 text-muted"></i>
                                            }
                                        </div>
                                        <div class="flex-grow-1 min-width-0">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <h6 class="mb-0 fw-bold text-truncate">@sponsor.Name</h6>
                                                @if (!sponsor.IsActive)
                                                {
                                                    <span class="badge bg-secondary rounded-pill">Inactive</span>
                                                }
                                            </div>
                                            <span class="badge @TierBadgeClass(sponsor.Tier) rounded-pill mt-1">
                                                <i class="bi @TierIconClass(sponsor.Tier) me-1"></i>@sponsor.Tier
                                            </span>
                                            @if (sponsor.SponsorshipYear.HasValue)
                                            {
                                                <span class="badge bg-light text-muted rounded-pill mt-1 ms-1">@sponsor.SponsorshipYear</span>
                                            }
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(sponsor.Description))
                                    {
                                        <p class="text-muted small mb-2" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                            @sponsor.Description
                                        </p>
                                    }

                                    <div class="d-flex flex-column gap-1 mb-3">
                                        @if (!string.IsNullOrEmpty(sponsor.Website))
                                        {
                                            <a href="@sponsor.Website" target="_blank" rel="noopener"
                                               class="small text-decoration-none text-truncate">
                                                <i class="bi bi-globe me-1 text-primary"></i>@sponsor.Website
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(sponsor.ContactName))
                                        {
                                            <span class="small text-muted">
                                                <i class="bi bi-person me-1"></i>@sponsor.ContactName
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(sponsor.ContactEmail))
                                        {
                                            <a href="mailto:@sponsor.ContactEmail" class="small text-muted text-decoration-none text-truncate">
                                                <i class="bi bi-envelope me-1"></i>@sponsor.ContactEmail
                                            </a>
                                        }
                                    </div>

                                    <!-- Actions -->
                                    <div class="d-flex gap-2 flex-wrap">
                                        <!-- Activate / Deactivate -->
                                        <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                            <input type="hidden" name="sponsorId" value="@sponsor.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm @(sponsor.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                                <i class="bi @(sponsor.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                                @(sponsor.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                        <!-- Assign to Event -->
                                        @if (Model.RecentEvents.Any())
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#assignEventModal-@sponsor.Id">
                                                <i class="bi bi-calendar-plus me-1"></i>Assign
                                            </button>
                                        }
                                        <!-- Delete -->
                                        <form method="post" asp-page-handler="Delete" class="d-inline"
                                              onsubmit="return confirm('Remove @sponsor.Name as a sponsor? This cannot be undone.');">
                                            <input type="hidden" name="sponsorId" value="@sponsor.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Assign to Event Modal (per sponsor) -->
                        @if (Model.RecentEvents.Any())
                        {
                            <div class="modal fade" id="assignEventModal-@sponsor.Id" tabindex="-1">
                                <div class="modal-dialog modal-sm">
                                    <form method="post" asp-page-handler="AssignToEvent" class="modal-content">
                                        <input type="hidden" name="sponsorId" value="@sponsor.Id" />
                                        <div class="modal-header">
                                            <h6 class="modal-title fw-semibold">
                                                <i class="bi bi-calendar-plus me-2 text-primary"></i>Assign to Event
                                            </h6>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="small text-muted mb-2">Select an event for <strong>@sponsor.Name</strong>:</p>
                                            <select name="eventId" class="form-select" required>
                                                <option value="" disabled selected>Choose event…</option>
                                                @foreach (var ev in Model.RecentEvents)
                                                {
                                                    <option value="@ev.Id">@ev.Name (@ev.EventDate.ToString("MMM d, yyyy"))</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="bi bi-check me-1"></i>Assign
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Add Sponsor Modal -->
<div class="modal fade" id="addSponsorModal" tabindex="-1" aria-labelledby="addSponsorModalLabel">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold" id="addSponsorModalLabel">
                    <i class="bi bi-building me-2 text-warning"></i>Add Sponsor
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <!-- Name -->
                    <div class="col-sm-8">
                        <label class="form-label fw-semibold">Company / Sponsor Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" maxlength="200"
                               placeholder="e.g. Acme Golf Co." required />
                    </div>
                    <!-- Tier -->
                    <div class="col-sm-4">
                        <label class="form-label fw-semibold">Tier</label>
                        <select name="tier" class="form-select" id="tierSelect">
                            <option value="4">⭐ Title</option>
                            <option value="3">🏆 Gold</option>
                            <option value="2" selected>🥈 Silver</option>
                            <option value="1">🥉 Bronze</option>
                            <option value="0">❤️ Community</option>
                        </select>
                    </div>
                    <!-- Logo URL -->
                    <div class="col-sm-8">
                        <label class="form-label fw-semibold">Logo URL <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="url" name="logoUrl" class="form-control"
                               placeholder="https://example.com/logo.png" />
                    </div>
                    <!-- Sponsorship Year -->
                    <div class="col-sm-4">
                        <label class="form-label fw-semibold">Year <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="number" name="sponsorshipYear" class="form-control"
                               value="@DateTime.UtcNow.Year" min="2000" max="2099" />
                    </div>
                    <!-- Website -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">Website <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="url" name="website" class="form-control"
                               placeholder="https://sponsor-website.com" />
                    </div>
                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">Description <span class="text-muted fw-normal">(optional)</span></label>
                        <textarea name="description" class="form-control" rows="2"
                                  placeholder="Short description shown on sponsor cards…"></textarea>
                    </div>
                    <!-- Contact Name -->
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Contact Name <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="contactName" class="form-control"
                               placeholder="Jane Smith" />
                    </div>
                    <!-- Contact Email -->
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Contact Email <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="email" name="contactEmail" class="form-control"
                               placeholder="contact@sponsor.com" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning text-dark">
                    <i class="bi bi-plus-lg me-1"></i>Add Sponsor
                </button>
            </div>
        </form>
    </div>
</div>
