@page
@model GolfDay.Web.Areas.Admin.Pages.Clubs.IndexModel
@{
    ViewData["Title"] = "Manage Clubs";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                    <li class="breadcrumb-item active">Clubs</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0"><i class="bi bi-buildings me-2 text-success"></i>Clubs</h1>
        </div>
        <a asp-area="Admin" asp-page="/Clubs/Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>Create New Club
        </a>
    </div>

    <!-- Search / Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-sm-6 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.Search" class="form-control border-start-0"
                               placeholder="Search clubs..." />
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                    <a asp-page="Index" class="btn btn-link text-muted">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Clubs Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold">
                All Clubs
                <span class="badge bg-success rounded-pill ms-2">@Model.Clubs.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Clubs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width:30%">Club Name</th>
                                <th>Location</th>
                                <th class="text-center">Members</th>
                                <th class="text-center">Active Events</th>
                                <th class="text-center">Courses</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var club in Model.Clubs)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(club.LogoUrl))
                                            {
                                                <img src="@club.LogoUrl" alt="@club.Name" class="rounded-circle"
                                                     style="width:40px;height:40px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center"
                                                     style="width:40px;height:40px;">
                                                    <i class="bi bi-buildings text-success"></i>
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-semibold">@club.Name</div>
                                                @if (!string.IsNullOrEmpty(club.Slug))
                                                {
                                                    <div class="text-muted small">/@club.Slug</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted small">
                                        @if (!string.IsNullOrEmpty(club.City) || !string.IsNullOrEmpty(club.State))
                                        {
                                            <i class="bi bi-geo-alt me-1"></i>
                                            @string.Join(", ", new[] { club.City, club.State }.Where(s => !string.IsNullOrEmpty(s)))
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not specified</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info bg-opacity-15 text-info fw-semibold rounded-pill px-3">
                                            @Model.MemberCounts.GetValueOrDefault(club.Id, 0)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary bg-opacity-15 text-primary fw-semibold rounded-pill px-3">
                                            @Model.ActiveEventCounts.GetValueOrDefault(club.Id, 0)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success bg-opacity-15 text-success fw-semibold rounded-pill px-3">
                                            @Model.CourseCounts.GetValueOrDefault(club.Id, 0)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (club.IsActive)
                                        {
                                            <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill"><i class="bi bi-pause-circle me-1"></i>Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-area="Admin" asp-page="/Clubs/Manage" asp-route-id="@club.Id"
                                               class="btn btn-outline-success" title="Manage Club">
                                                <i class="bi bi-gear me-1"></i>Manage
                                            </a>
                                            <a asp-area="Admin" asp-page="/Events/Index" asp-route-clubId="@club.Id"
                                               class="btn btn-outline-primary" title="View Events">
                                                <i class="bi bi-calendar-event me-1"></i>Events
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-buildings fs-1 opacity-25 d-block mb-3"></i>
                    <p class="mb-2">No clubs found.</p>
                    <a asp-area="Admin" asp-page="/Clubs/Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Create First Club
                    </a>
                </div>
            }
        </div>
    </div>
</div>
