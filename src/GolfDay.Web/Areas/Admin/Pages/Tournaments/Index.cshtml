@page
@model GolfDay.Web.Areas.Admin.Pages.Tournaments.IndexModel
@{
    ViewData["Title"] = "Tournaments";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                    <li class="breadcrumb-item active">Tournaments</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">
                <i class="bi bi-trophy me-2 text-warning"></i>Tournaments
            </h1>
        </div>
        <a asp-area="Admin" asp-page="/Tournaments/Create" class="btn btn-warning text-dark">
            <i class="bi bi-plus-circle me-2"></i>Create Tournament
        </a>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-sm-6 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.Search"
                               class="form-control border-start-0" placeholder="Search tournaments..." />
                    </div>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<TournamentStatus>())
                        {
                            <option value="@s" selected="@(Model.StatusFilter == s.ToString())">@s</option>
                        }
                    </select>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="clubFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Clubs</option>
                        @foreach (var club in Model.Clubs)
                        {
                            <option value="@club.Id" selected="@(Model.ClubFilter == club.Id)">@club.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-page="Index" class="btn btn-link text-muted">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tournaments Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold">
                All Tournaments
                <span class="badge bg-warning text-dark rounded-pill ms-2">@Model.Tournaments.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Tournaments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Tournament</th>
                                <th>Club</th>
                                <th>Format</th>
                                <th>Dates</th>
                                <th class="text-center">Entries</th>
                                <th class="text-center">Rounds</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Tournaments)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@t.Name</div>
                                        @if (!string.IsNullOrEmpty(t.Description))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width:260px;">
                                                @t.Description
                                            </div>
                                        }
                                    </td>
                                    <td class="text-muted small">@t.Club?.Name</td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-15 text-secondary rounded-pill">
                                            @t.Format
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        <div><i class="bi bi-calendar-event me-1"></i>@t.StartDate.ToString("MMM d, yyyy")</div>
                                        <div><i class="bi bi-calendar2-check me-1"></i>@t.EndDate.ToString("MMM d, yyyy")</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @t.Entries.Count / @t.MaxParticipants
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @t.NumberOfRounds
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var (badgeClass, icon) = t.Status switch
                                            {
                                                TournamentStatus.Registration => ("bg-primary",   "bi-pencil-square"),
                                                TournamentStatus.Active       => ("bg-success",   "bi-play-circle"),
                                                TournamentStatus.Completed    => ("bg-secondary", "bi-check-circle"),
                                                TournamentStatus.Cancelled    => ("bg-danger",    "bi-x-circle"),
                                                TournamentStatus.Suspended    => ("bg-warning",   "bi-pause-circle"),
                                                _                             => ("bg-light text-dark", "bi-circle")
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill">
                                            <i class="bi @icon me-1"></i>@t.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-area="Admin" asp-page="/Tournaments/Manage"
                                               asp-route-id="@t.Id"
                                               class="btn btn-outline-warning text-dark" title="Manage">
                                                <i class="bi bi-gear me-1"></i>Manage
                                            </a>
                                            <a asp-area="Admin" asp-page="/Events/Index"
                                               asp-route-tournamentId="@t.Id"
                                               class="btn btn-outline-secondary" title="Rounds">
                                                <i class="bi bi-list-ol"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-trophy fs-1 opacity-25 d-block mb-3"></i>
                    <p class="mb-2">No tournaments found.</p>
                    <a asp-area="Admin" asp-page="/Tournaments/Create" class="btn btn-warning btn-sm text-dark">
                        <i class="bi bi-plus-circle me-1"></i>Create First Tournament
                    </a>
                </div>
            }
        </div>
    </div>
</div>
