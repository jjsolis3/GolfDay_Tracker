@page "{id:int}"
@model GolfDay.Web.Areas.Admin.Pages.League.ManageModel
@{
    ViewData["Title"] = $"Manage League – {Model.Season?.Name}";
    var activeTab = Context.Request.Query["tab"].FirstOrDefault() ?? "overview";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/League/Index">Leagues</a></li>
                    <li class="breadcrumb-item active">@Model.Season?.Name</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">
                <i class="bi bi-diagram-3 me-2 text-info"></i>@Model.Season?.Name
            </h1>
            <p class="text-muted mb-0 mt-1">
                <span class="me-3"><i class="bi bi-buildings me-1"></i>@Model.Season?.Club?.Name</span>
                <span class="me-3"><i class="bi bi-calendar-event me-1"></i>
                    @Model.Season?.StartDate.ToString("MMM d") – @Model.Season?.EndDate.ToString("MMM d, yyyy")
                </span>
                @{
                    var (sbadge, sicon) = Model.Season?.Status switch
                    {
                        LeagueStatus.Registration => ("bg-primary",   "bi-pencil-square"),
                        LeagueStatus.Active       => ("bg-success",   "bi-play-circle"),
                        LeagueStatus.Completed    => ("bg-secondary", "bi-check-circle"),
                        LeagueStatus.Cancelled    => ("bg-danger",    "bi-x-circle"),
                        LeagueStatus.Paused       => ("bg-warning",   "bi-pause-circle"),
                        _                         => ("bg-secondary", "bi-circle")
                    };
                }
                <span class="badge @sbadge rounded-pill"><i class="bi @sicon me-1"></i>@Model.Season?.Status</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Season?.Status == LeagueStatus.Registration || Model.Season?.Status == LeagueStatus.Active)
            {
                <form method="post" asp-page-handler="GenerateSchedule">
                    <button type="submit" class="btn btn-info text-white"
                            onclick="return confirm('Generate schedule? This will create all round-robin match slots.');">
                        <i class="bi bi-shuffle me-1"></i>Generate Schedule
                    </button>
                </form>
            }
            <a asp-area="Admin" asp-page="/League/Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(activeTab == "overview" ? "active" : "")" href="?tab=overview">
                <i class="bi bi-info-circle me-1"></i>Overview
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "players" ? "active" : "")" href="?tab=players">
                <i class="bi bi-people me-1"></i>Players
                <span class="badge bg-secondary rounded-pill ms-1">@Model.Entries.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "matches" ? "active" : "")" href="?tab=matches">
                <i class="bi bi-calendar2-week me-1"></i>Matches
                <span class="badge bg-secondary rounded-pill ms-1">@Model.Matches.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "standings" ? "active" : "")" href="?tab=standings">
                <i class="bi bi-bar-chart-line me-1"></i>Standings
            </a>
        </li>
    </ul>

    <!-- Overview Tab -->
    @if (activeTab == "overview")
    {
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0 fw-semibold"><i class="bi bi-card-text me-2 text-info"></i>Season Details</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Format</dt>
                            <dd class="col-sm-8">@Model.Season?.Format</dd>

                            <dt class="col-sm-4 text-muted">Registration Deadline</dt>
                            <dd class="col-sm-8">
                                @(Model.Season?.RegistrationDeadline?.ToString("MMM d, yyyy") ?? "—")
                            </dd>

                            <dt class="col-sm-4 text-muted">Max Participants</dt>
                            <dd class="col-sm-8">@Model.Season?.MaxParticipants</dd>

                            <dt class="col-sm-4 text-muted">Match Deadline</dt>
                            <dd class="col-sm-8">@Model.Season?.MatchDeadlineDays days per match</dd>

                            <dt class="col-sm-4 text-muted">Points (W/D/L)</dt>
                            <dd class="col-sm-8">
                                @Model.Season?.PointsForWin /
                                @Model.Season?.PointsForDraw /
                                @Model.Season?.PointsForLoss
                            </dd>

                            <dt class="col-sm-4 text-muted">Handicaps</dt>
                            <dd class="col-sm-8">
                                @if (Model.Season?.UseHandicaps == true)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Season Stats</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-people me-2 text-info"></i>Players Registered</span>
                            <span class="badge bg-info rounded-pill fs-6">@Model.Entries.Count</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-calendar2-week me-2 text-primary"></i>Total Matches</span>
                            <span class="badge bg-primary rounded-pill fs-6">@Model.Matches.Count</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-check-circle me-2 text-success"></i>Completed</span>
                            <span class="badge bg-success rounded-pill fs-6">
                                @Model.Matches.Count(m => m.Status == MatchStatus.Completed)
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-hourglass me-2 text-warning"></i>Pending</span>
                            <span class="badge bg-warning text-dark rounded-pill fs-6">
                                @Model.Matches.Count(m => m.Status == MatchStatus.Scheduled)
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Overdue</span>
                            <span class="badge bg-danger rounded-pill fs-6">
                                @Model.Matches.Count(m => m.Status == MatchStatus.Overdue)
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Players Tab -->
    @if (activeTab == "players")
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-people me-2 text-info"></i>Registered Players
                    <span class="badge bg-info rounded-pill ms-2">@Model.Entries.Count</span>
                </h5>
                <button type="button" class="btn btn-info btn-sm text-white"
                        data-bs-toggle="modal" data-bs-target="#addPlayerModal">
                    <i class="bi bi-person-plus me-1"></i>Add Player
                </button>
            </div>
            <div class="card-body p-0">
                @if (Model.Entries.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">#</th>
                                    <th>Player</th>
                                    <th>Handicap at Entry</th>
                                    <th>Seed</th>
                                    <th>Registered</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var rank = 1;
                                }
                                @foreach (var entry in Model.Entries)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted">@rank</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center"
                                                     style="width:34px;height:34px;min-width:34px;">
                                                    <i class="bi bi-person text-info"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@entry.User.FullName</div>
                                                    <div class="text-muted small">@entry.User.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @(entry.HandicapAtEntry.HasValue
                                                ? entry.HandicapAtEntry.Value.ToString("F1")
                                                : "—")
                                        </td>
                                        <td class="text-muted">@(entry.SeedNumber?.ToString() ?? "—")</td>
                                        <td class="text-muted small">@entry.RegisteredAt.ToString("MMM d, yyyy")</td>
                                        <td>
                                            @if (entry.IsActive)
                                            {
                                                <span class="badge bg-success rounded-pill">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill">Withdrawn</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <form method="post" asp-page-handler="RemovePlayer"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Remove this player from the league?');">
                                                <input type="hidden" name="entryId" value="@entry.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-people fs-1 opacity-25 d-block mb-2"></i>
                        No players registered yet.
                    </div>
                }
            </div>
        </div>

        <!-- Add Player Modal -->
        <div class="modal fade" id="addPlayerModal" tabindex="-1">
            <div class="modal-dialog">
                <form method="post" asp-page-handler="AddPlayer" class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add Player to League</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Player Email</label>
                            <input type="email" name="playerEmail" class="form-control"
                                   placeholder="player@example.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Handicap at Entry <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="number" name="handicapAtEntry" class="form-control"
                                   step="0.1" min="0" max="54" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Seed Number <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="number" name="seedNumber" class="form-control" min="1" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-info text-white">
                            <i class="bi bi-person-plus me-1"></i>Add Player
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Matches Tab -->
    @if (activeTab == "matches")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-calendar2-week me-2 text-primary"></i>Match Schedule
                    <span class="badge bg-primary rounded-pill ms-2">@Model.Matches.Count</span>
                </h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Matches.Any())
                {
                    var rounds = Model.Matches.GroupBy(m => m.RoundNumber).OrderBy(g => g.Key);
                    foreach (var roundGroup in rounds)
                    {
                        <div class="px-4 py-2 bg-light border-bottom">
                            <small class="fw-semibold text-uppercase text-muted tracking-wide">
                                Round @roundGroup.Key
                            </small>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light" style="display:none;">
                                    <tr>
                                        <th>Player 1</th><th>vs</th><th>Player 2</th>
                                        <th>Deadline</th><th>Status</th><th>Result</th><th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var match in roundGroup.OrderBy(m => m.ScheduledDeadline))
                                    {
                                        <tr>
                                            <td class="ps-4" style="width:25%">
                                                <div class="fw-semibold @(match.WinnerId == match.Player1Id ? "text-success" : "")">
                                                    @match.Player1.FullName
                                                </div>
                                                @if (match.Player1NetScore.HasValue)
                                                {
                                                    <div class="text-muted small">Net: @match.Player1NetScore</div>
                                                }
                                            </td>
                                            <td class="text-center text-muted fw-bold">vs</td>
                                            <td style="width:25%">
                                                <div class="fw-semibold @(match.WinnerId == match.Player2Id ? "text-success" : "")">
                                                    @match.Player2.FullName
                                                </div>
                                                @if (match.Player2NetScore.HasValue)
                                                {
                                                    <div class="text-muted small">Net: @match.Player2NetScore</div>
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                <i class="bi bi-calendar-x me-1"></i>
                                                @match.ScheduledDeadline.ToString("MMM d, yyyy")
                                            </td>
                                            <td>
                                                @{
                                                    var (mbadge, micon) = match.Status switch
                                                    {
                                                        MatchStatus.Scheduled   => ("bg-primary",   "bi-calendar-check"),
                                                        MatchStatus.InProgress  => ("bg-info",      "bi-play-circle"),
                                                        MatchStatus.Completed   => ("bg-success",   "bi-check-circle"),
                                                        MatchStatus.Forfeited   => ("bg-warning",   "bi-flag"),
                                                        MatchStatus.Overdue     => ("bg-danger",    "bi-clock-history"),
                                                        MatchStatus.Cancelled   => ("bg-secondary", "bi-x-circle"),
                                                        _                       => ("bg-light text-dark", "bi-circle")
                                                    };
                                                }
                                                <span class="badge @mbadge rounded-pill">
                                                    <i class="bi @micon me-1"></i>@match.Status
                                                </span>
                                            </td>
                                            <td class="text-muted small">
                                                @if (match.IsDraw)
                                                {
                                                    <span class="badge bg-secondary">Draw</span>
                                                }
                                                else if (!string.IsNullOrEmpty(match.WinnerId))
                                                {
                                                    <span class="badge bg-success">
                                                        @(match.WinnerId == match.Player1Id
                                                            ? match.Player1.FullName
                                                            : match.Player2.FullName) wins
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                @if (match.Status != MatchStatus.Completed)
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-success btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#resultModal"
                                                            data-match-id="@match.Id"
                                                            data-p1="@match.Player1.FullName"
                                                            data-p2="@match.Player2.FullName">
                                                        <i class="bi bi-pencil-square me-1"></i>Record
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar2-week fs-1 opacity-25 d-block mb-3"></i>
                        <p class="mb-2">No matches scheduled yet.</p>
                        @if (Model.Entries.Count >= 2)
                        {
                            <form method="post" asp-page-handler="GenerateSchedule" class="d-inline">
                                <button type="submit" class="btn btn-info btn-sm text-white">
                                    <i class="bi bi-shuffle me-1"></i>Generate Schedule
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted small">Add at least 2 players to generate a schedule.</p>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Record Result Modal -->
        <div class="modal fade" id="resultModal" tabindex="-1">
            <div class="modal-dialog">
                <form method="post" asp-page-handler="RecordResult" class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Record Match Result</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="matchId" id="resultMatchId" />
                        <p class="fw-semibold mb-3" id="matchupDisplay"></p>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Outcome</label>
                            <select name="outcome" class="form-select" id="outcomeSelect">
                                <option value="player1">Player 1 Wins</option>
                                <option value="player2">Player 2 Wins</option>
                                <option value="draw">Draw / Halved</option>
                            </select>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold small">Player 1 Net Score</label>
                                <input type="number" name="player1NetScore" class="form-control" min="50" max="150" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small">Player 2 Net Score</label>
                                <input type="number" name="player2NetScore" class="form-control" min="50" max="150" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Date Played</label>
                            <input type="date" name="playedDate" class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Notes <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="text" name="resultNotes" class="form-control" maxlength="200" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i>Save Result
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @section Scripts {
            <script>
                document.getElementById('resultModal').addEventListener('show.bs.modal', function (event) {
                    var btn = event.relatedTarget;
                    document.getElementById('resultMatchId').value = btn.getAttribute('data-match-id');
                    document.getElementById('matchupDisplay').textContent =
                        btn.getAttribute('data-p1') + ' vs ' + btn.getAttribute('data-p2');
                });
            </script>
        }
    }

    <!-- Standings Tab -->
    @if (activeTab == "standings")
    {
        <div class="d-flex justify-content-end mb-3">
            <form method="post" asp-page-handler="RecalculateStandings">
                <button type="submit" class="btn btn-outline-info">
                    <i class="bi bi-arrow-clockwise me-1"></i>Recalculate Standings
                </button>
            </form>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-bar-chart-line me-2 text-success"></i>League Standings
                </h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Standings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 text-center" style="width:60px;">Rank</th>
                                    <th>Player</th>
                                    <th class="text-center">P</th>
                                    <th class="text-center">W</th>
                                    <th class="text-center">D</th>
                                    <th class="text-center">L</th>
                                    <th class="text-center fw-bold">Pts</th>
                                    <th class="text-center">Avg Score</th>
                                    <th class="text-center">Best Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var standing in Model.Standings.OrderBy(s => s.Rank))
                                {
                                    <tr class="@(standing.Rank <= 3 ? "table-warning" : "")">
                                        <td class="ps-4 text-center">
                                            @if (standing.Rank == 1)
                                            {
                                                <i class="bi bi-trophy-fill text-warning fs-5"></i>
                                            }
                                            else if (standing.Rank == 2)
                                            {
                                                <span class="text-secondary fw-bold">2nd</span>
                                            }
                                            else if (standing.Rank == 3)
                                            {
                                                <span class="fw-bold" style="color:#cd7f32;">3rd</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@standing.Rank</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center"
                                                     style="width:34px;height:34px;min-width:34px;">
                                                    <i class="bi bi-person text-success"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@standing.User.FullName</div>
                                                    <div class="text-muted small">@standing.User.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@standing.Played</td>
                                        <td class="text-center text-success fw-semibold">@standing.Wins</td>
                                        <td class="text-center text-secondary">@standing.Draws</td>
                                        <td class="text-center text-danger">@standing.Losses</td>
                                        <td class="text-center fw-bold fs-6">@standing.Points</td>
                                        <td class="text-center text-muted">
                                            @(standing.AverageScore.HasValue
                                                ? standing.AverageScore.Value.ToString("F1")
                                                : "—")
                                        </td>
                                        <td class="text-center text-muted">@(standing.BestScore?.ToString() ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-bar-chart-line fs-1 opacity-25 d-block mb-2"></i>
                        No standings calculated yet. Complete some matches and recalculate.
                    </div>
                }
            </div>
        </div>
    }
</div>
