@page
@model GolfDay.Web.Areas.Admin.Pages.League.IndexModel
@{
    ViewData["Title"] = "League Seasons";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                    <li class="breadcrumb-item active">Leagues</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">
                <i class="bi bi-diagram-3 me-2 text-info"></i>League Seasons
            </h1>
        </div>
        <a asp-area="Admin" asp-page="/League/Create" class="btn btn-info text-white">
            <i class="bi bi-plus-circle me-2"></i>Create League Season
        </a>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-sm-6 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.Search"
                               class="form-control border-start-0" placeholder="Search league seasons..." />
                    </div>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<LeagueStatus>())
                        {
                            <option value="@s" selected="@(Model.StatusFilter == s.ToString())">@s</option>
                        }
                    </select>
                </div>
                <div class="col-sm-4 col-md-2">
                    <select name="clubFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Clubs</option>
                        @foreach (var club in Model.Clubs)
                        {
                            <option value="@club.Id" selected="@(Model.ClubFilter == club.Id)">@club.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-page="Index" class="btn btn-link text-muted">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Seasons Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold">
                All League Seasons
                <span class="badge bg-info rounded-pill ms-2">@Model.Seasons.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Seasons.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Season</th>
                                <th>Club</th>
                                <th>Format</th>
                                <th>Dates</th>
                                <th class="text-center">Players</th>
                                <th class="text-center">Matches</th>
                                <th class="text-center">Completion</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var season in Model.Seasons)
                            {
                                var totalMatches = season.Matches.Count;
                                var completedMatches = season.Matches.Count(m => m.Status == MatchStatus.Completed);
                                var pct = totalMatches > 0 ? (completedMatches * 100 / totalMatches) : 0;

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@season.Name</div>
                                        @if (!string.IsNullOrEmpty(season.Description))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width:200px;">
                                                @season.Description
                                            </div>
                                        }
                                    </td>
                                    <td class="text-muted small">@season.Club?.Name</td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-15 text-secondary rounded-pill">
                                            @season.Format
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        <div><i class="bi bi-calendar-event me-1"></i>@season.StartDate.ToString("MMM d, yyyy")</div>
                                        <div><i class="bi bi-calendar2-check me-1"></i>@season.EndDate.ToString("MMM d, yyyy")</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info bg-opacity-15 text-info fw-semibold rounded-pill px-3">
                                            @season.Entries.Count
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary bg-opacity-15 text-secondary rounded-pill px-3">
                                            @completedMatches / @totalMatches
                                        </span>
                                    </td>
                                    <td style="min-width:130px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;">
                                                <div class="progress-bar bg-info" role="progressbar"
                                                     style="width:@pct%"
                                                     aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                                </div>
                                            </div>
                                            <small class="text-muted">@pct%</small>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var (badgeClass, icon) = season.Status switch
                                            {
                                                LeagueStatus.Registration => ("bg-primary",   "bi-pencil-square"),
                                                LeagueStatus.Active       => ("bg-success",   "bi-play-circle"),
                                                LeagueStatus.Completed    => ("bg-secondary", "bi-check-circle"),
                                                LeagueStatus.Cancelled    => ("bg-danger",    "bi-x-circle"),
                                                LeagueStatus.Paused       => ("bg-warning",   "bi-pause-circle"),
                                                _                         => ("bg-light text-dark", "bi-circle")
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill">
                                            <i class="bi @icon me-1"></i>@season.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-area="Admin" asp-page="/League/Manage"
                                           asp-route-id="@season.Id"
                                           class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-gear me-1"></i>Manage
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-diagram-3 fs-1 opacity-25 d-block mb-3"></i>
                    <p class="mb-2">No league seasons found.</p>
                    <a asp-area="Admin" asp-page="/League/Create" class="btn btn-info btn-sm text-white">
                        <i class="bi bi-plus-circle me-1"></i>Create First Season
                    </a>
                </div>
            }
        </div>
    </div>
</div>
