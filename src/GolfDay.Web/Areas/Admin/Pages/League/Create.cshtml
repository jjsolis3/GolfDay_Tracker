@page
@model GolfDay.Web.Areas.Admin.Pages.League.CreateLeagueModel
@{
    ViewData["Title"] = "Create League Season";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Admin</a></li>
            <li class="breadcrumb-item"><a asp-page="/League/Index">Leagues</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-info bg-opacity-10 fw-bold py-3">
            <i class="bi bi-people me-2 text-info"></i>Create New League Season
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Input.Name" class="form-label fw-semibold">League Name *</label>
                        <input asp-for="Input.Name" class="form-control" placeholder="e.g. 2024 Summer Match Play League" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.ClubId" class="form-label fw-semibold">Club *</label>
                        <select asp-for="Input.ClubId" asp-items="Model.ClubSelectList" class="form-select">
                            <option value="">Select Club...</option>
                        </select>
                        <span asp-validation-for="Input.ClubId" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Format" class="form-label fw-semibold">Format *</label>
                        <select asp-for="Input.Format" class="form-select">
                            @foreach (var format in Enum.GetValues<GolfDay.Domain.Enums.LeagueFormat>())
                            {
                                <option value="@format">@format</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.StartDate" class="form-label fw-semibold">Season Start *</label>
                        <input asp-for="Input.StartDate" type="date" class="form-control" />
                        <span asp-validation-for="Input.StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.EndDate" class="form-label fw-semibold">Season End *</label>
                        <input asp-for="Input.EndDate" type="date" class="form-control" />
                        <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.MaxParticipants" class="form-label fw-semibold">Max Players</label>
                        <input asp-for="Input.MaxParticipants" type="number" min="2" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.MatchDeadlineDays" class="form-label fw-semibold">Match Deadline (days)</label>
                        <input asp-for="Input.MatchDeadlineDays" type="number" min="1" max="90" class="form-control" />
                        <small class="text-muted">Days to complete each match</small>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.PointsForWin" class="form-label fw-semibold">Win Pts</label>
                        <input asp-for="Input.PointsForWin" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.PointsForDraw" class="form-label fw-semibold">Draw Pts</label>
                        <input asp-for="Input.PointsForDraw" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.PointsForLoss" class="form-label fw-semibold">Loss Pts</label>
                        <input asp-for="Input.PointsForLoss" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="Input.UseHandicaps" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.UseHandicaps" class="form-check-label">Use Handicaps</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Rules" class="form-label fw-semibold">Rules</label>
                        <textarea asp-for="Input.Rules" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Prizes" class="form-label fw-semibold">Prizes</label>
                        <textarea asp-for="Input.Prizes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-info px-4 text-white">
                        <i class="bi bi-people me-2"></i>Create League
                    </button>
                    <a asp-page="/League/Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
